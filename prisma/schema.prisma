generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  IT_AGENT
  DEPARTMENT_MANAGER
  // Cross-department oversight: view (and create projects/activities) in
  // every department, without the admin.*/user.manage/role.manage/
  // department.manage* power Administrator has. See canViewAllDepartments()
  // in lib/permissions.ts and its use in workspace-service.ts /
  // department-scope-service.ts.
  DIRECTOR
  USER
}

enum TicketSource {
  WEB
  EMAIL
  // Created by a server-to-server call to POST /api/integrations/tickets,
  // authenticated via an ExternalIntegration API key — see that model below.
  API
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL_NOTE
}

enum TicketHistoryType {
  CREATED
  STATUS_CHANGE
  PRIORITY_CHANGE
  CATEGORY_CHANGE
  ASSIGNMENT_CHANGE
  DEPARTMENT_CHANGE
  CLOSED
  REOPENED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  CANCEL_REASON_SET
}

enum AuthProvider {
  MICROSOFT
  CREDENTIALS
}

// Standing within a single department — distinct from the global `Role` enum,
// which governs cross-cutting/system concerns (admin panel, credentials login).
// System Admin is represented by the global `Role.ADMIN` and bypasses these
// entirely rather than being a value here (see lib/permissions.ts).
enum DepartmentRole {
  DEPARTMENT_ADMIN
  DEPARTMENT_MANAGER
  PROJECT_MANAGER
  AGENT_ASSIGNEE
  REQUESTER
  VIEWER
}

// How a DepartmentMembership row was established. MANUAL rows are admin
// overrides and must never be modified by the Microsoft login-sync process.
enum MembershipSource {
  MICROSOFT_DEPARTMENT
  MICROSOFT_GROUP
  MICROSOFT_APP_ROLE
  MICROSOFT_JOB_TITLE
  MANUAL
}

// How User.role (the GLOBAL role, distinct from DepartmentRole) was last
// set — mirrors MembershipSource's protection model so the same "never
// overwrite a manual decision" rule applies to the global role too. SYSTEM
// (not MANUAL) is the default so fresh/seeded users stay eligible for
// Microsoft sync until an admin actually makes an explicit choice.
enum GlobalRoleSource {
  SYSTEM
  MANUAL
  MICROSOFT_DEPARTMENT
}

// Provenance of User.image — same "never overwrite a manual decision"
// protection model as MembershipSource/GlobalRoleSource above. MANUAL means
// an admin or the user themself explicitly set the image (no such write path
// exists yet in the app, but this flag is what any future upload feature
// MUST set — see lib/services/microsoft-profile-photo-service.ts). Null
// means "never explicitly tracked" (legacy rows from before this field
// existed) — the sync service treats null the same as MICROSOFT for update
// eligibility, since historically the only code path that ever wrote
// User.image was the Microsoft sign-in flow.
enum AvatarSource {
  MICROSOFT
  MANUAL
}

// Which kind of Microsoft/Entra signal a MicrosoftDepartmentMapping row
// matches against.
enum MicrosoftMappingSourceType {
  PROFILE_DEPARTMENT
  PROFILE_JOB_TITLE
  ENTRA_GROUP
  ENTRA_APP_ROLE
}

// RUNNING = no `completedAt` yet. SUCCEEDED = completed, errorCount stayed 0.
// PARTIAL = completed, some per-user records were skipped/errored but the run
// itself finished (see OrganizationSyncRun.errorCount) — never a hard
// all-or-nothing failure for one bad record. FAILED = the run itself aborted
// (e.g. lost the Graph token mid-run, permission revoked).
enum OrganizationSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

// FULL = paginated tenant-wide user directory scan + manager/directReports
// traversal. INCREMENTAL = user property refresh only (no manager traversal)
// — cheaper, safe to run more often. RELATIONSHIP_REFRESH = manager/
// directReports traversal only, skips the directory property scan — for
// periodically refreshing reporting lines without re-scanning every profile
// field.
enum OrganizationSyncType {
  FULL
  INCREMENTAL
  RELATIONSHIP_REFRESH
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  COMPLETED
  CANCELLED
}

// ─── Organisation Structure ───────────────────────────────────────────────────

model Company {
  id                String         @id @default(cuid())
  name              String
  // Trim + collapse-whitespace + lowercase of `name` (see
  // lib/services/organization-normalization.ts's normalizeCompanyName) — the
  // real duplicate-prevention backstop for "one Company root per
  // normalized Microsoft companyName" (Microsoft Directory Sync,
  // lib/services/organization-directory-sync-service.ts), the same
  // database-level-constraint-as-hard-backstop pattern already used for
  // User.email (see the add_user_email_case_insensitive_unique migration) —
  // application-level normalization alone is a convention, not a guarantee.
  normalizedName    String         @unique
  // Optional: a Microsoft-sourced company (matched/created purely from
  // Entra's free-text companyName) has no inherent domain — only a manually
  // admin-created company (via /admin/companies) is expected to always set
  // one. Still unique when present.
  domain            String?        @unique
  businessUnits     BusinessUnit[]
  // Departments attached directly to this Company (no BusinessUnit) — the
  // path Microsoft Directory Sync always uses, since Entra has no "business
  // unit" concept of its own. A manually admin-organized department instead
  // goes through `businessUnit` above, unchanged. See
  // lib/services/organization-directory-sync-service.ts and
  // lib/services/organization-tree-service.ts (which renders both paths
  // under the same Company node).
  directDepartments Department[]   @relation("DepartmentDirectCompany")
  users             User[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model BusinessUnit {
  id          String            @id @default(cuid())
  name        String
  company     Company           @relation(fields: [companyId], references: [id])
  companyId   String
  departments Department[]
  users       User[]
  projects    Project[]
  activities  ProjectActivity[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Department {
  id                      String                       @id @default(cuid())
  name                    String
  // Trim + collapse-whitespace + lowercase of `name` (see
  // lib/services/organization-normalization.ts's normalizeDepartmentName) —
  // paired with `companyId` below in a uniqueness backstop so Microsoft
  // Directory Sync can never create two "IT" departments under the same
  // Company. Nullable for backward compatibility with departments that
  // predate this column (backfilled for existing rows in the migration that
  // introduced it) — always populated going forward (createDepartment/
  // updateDepartment keep it in sync with `name`).
  normalizedName          String?
  slug                    String                       @unique
  description             String?
  isActive                Boolean                      @default(true)
  // Inbound mail routing address for the Pending Tickets flow — see
  // PendingTicket below. Normalized lowercase/trim before save (see
  // setDepartmentInboundEmail in lib/services/department-service.ts).
  // Null = not configured; unique across departments so one address can never
  // be claimed by two departments at once.
  inboundEmail            String?                      @unique
  businessUnit            BusinessUnit?                @relation(fields: [businessUnitId], references: [id])
  businessUnitId          String?
  // Direct Company placement — used ONLY when there's no meaningful
  // BusinessUnit to nest under (always true for a Microsoft-sourced
  // department, since Entra has no "business unit" concept). Mutually
  // exclusive with `businessUnitId` in practice (never both set), though the
  // schema doesn't hard-enforce that — see organization-tree-service.ts for
  // how the two paths are rendered under the same Company node either way.
  company                 Company?                     @relation("DepartmentDirectCompany", fields: [companyId], references: [id])
  companyId               String?
  subDepartments          SubDepartment[]
  users                   User[]
  memberships             DepartmentMembership[]
  microsoftMappings       MicrosoftDepartmentMapping[]
  tickets                 Ticket[]
  pendingTickets          PendingTicket[]
  projects                Project[]
  activities              ProjectActivity[]
  projectRequests         ProjectRequest[]
  categories              TicketCategory[]
  priorities              TicketPriority[]
  statuses                TicketStatus[]
  cancelReasons           TicketCancelReason[]
  activityProgressConfigs ActivityProgressConfig[]
  projectStatusConfigs    ProjectStatusConfig[]
  activityStatusConfigs   ActivityStatusConfig[]
  activityPriorityConfigs ActivityPriorityConfig[]
  externalIntegrations    ExternalIntegration[]        @relation("IntegrationDepartment")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  // Guards the direct-Company placement path only (companyId set,
  // businessUnitId null — always true for Microsoft Directory Sync). A
  // NULL companyId never collides with another NULL (standard SQL unique-index
  // semantics), so this has zero effect on departments organized via
  // businessUnitId instead.
  @@unique([companyId, normalizedName])
}

// Per-user, per-department standing. Decoupled from User.departmentId (which
// remains the legacy "home department" FK, unchanged) — a user may hold
// memberships in multiple departments; at most one is flagged isPrimary.
model DepartmentMembership {
  id           String           @id @default(cuid())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  role         DepartmentRole
  // Custom department-scoped role (CustomRole.scope DEPARTMENT/BOTH) — when
  // set, this is the source of truth for permission checks (mirrors
  // User.customRoleId exactly) and `role` above just holds a required,
  // unused placeholder (VIEWER). See getEffectiveDepartmentRoleKey in
  // lib/permissions.ts.
  customRole   CustomRole?      @relation("DepartmentMembershipCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)
  customRoleId String?
  source       MembershipSource
  isPrimary    Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
  @@index([customRoleId])
}

// Pure data table: maps a Microsoft/Entra signal (profile department string,
// group name/id, or app role value) to an internal department + role, so the
// login-sync logic never hardcodes a department name in code.
// DOMAIN SCOPE (FIND-006, docs/roadmap-handoff-register.md): canonical
// mapping identity is `(sourceType, domain, normalizedMicrosoftValue)` —
// NOT `(sourceType, microsoftValue)` alone (the pre-FIND-006 constraint,
// dropped by migration 20260807170000_mapping_domain_scoped_identity).
//
// Only PROFILE_JOB_TITLE is REALLY domain-aware today: `domain` holds the
// Entra domain (e.g. "kinsen.gr") the mapping applies to, required and
// validated against organization-directory-eligibility-service.ts's
// allowed-domain set whenever this sourceType is created/updated
// (microsoft-mapping-service.ts). This lets the SAME raw job title (e.g.
// "Director") have independent mappings per domain once a second domain is
// ever enabled — `kinsen.gr` is the only one enabled today
// (ALLOWED_EMAIL_DOMAIN) — with zero further schema change needed then.
//
// Every OTHER sourceType (PROFILE_DEPARTMENT, ENTRA_GROUP, ENTRA_APP_ROLE)
// deliberately stays GLOBAL — `domain` is always the empty-string sentinel
// `""` for these, never a real domain, and neither the admin UI nor
// createMapping/updateMapping ever let one be set. Reasoning per source
// type (see docs/roadmap-handoff-register.md FIND-006 for the full
// write-up):
//   - ENTRA_GROUP / ENTRA_APP_ROLE: a group id or app role value is a
//     tenant-wide Entra construct, never derived from a user's own
//     domain/email at all (buildCandidates in microsoft-mapping-service.ts
//     never looks at email for these) — "domain-scoping" them would be
//     meaningless, not just unnecessary.
//   - PROFILE_DEPARTMENT: also a per-user profile string like job title,
//     but organizational PLACEMENT (which department/company a user
//     belongs to) is already handled by an entirely separate, actually
//     domain-aware mechanism — organization-company-department-resolver.ts
//     — for the PRIMARY department. This mapping type exists only for
//     SECONDARY membership/global-role granting, has no reported
//     multi-domain requirement, and changing its matching semantics now
//     was explicitly out of scope. `domain`/`normalizedMicrosoftValue` still
//     exist on every row for a uniform storage/query shape — enabling it
//     later needs no further schema change, only a code change mirroring
//     what PROFILE_JOB_TITLE already does.
//
// `""` (empty string), not SQL NULL, is deliberately the "no domain / global"
// sentinel — same convention as MicrosoftDirectoryJobTitleValue.domain
// (see that model's comment). NULL would make the compound unique index
// silently stop preventing duplicate global mappings (Postgres treats every
// NULL as distinct from every other NULL in a unique index), which would be
// a real regression for ENTRA_GROUP/ENTRA_APP_ROLE/PROFILE_DEPARTMENT's
// existing "one mapping per raw value" guarantee.
//
// `normalizedMicrosoftValue` mirrors the discovery catalog's approach
// (MicrosoftDirectoryJobTitleValue.normalizedValue) so matching is
// deterministic and identical across BOTH tables — never two different
// normalization rules for the same feature:
//   - PROFILE_JOB_TITLE: normalizeJobTitleValue(microsoftValue) — trim +
//     collapse-whitespace + lowercase (microsoft-directory-service.ts),
//     the exact function the discovery catalog already uses. This also
//     means creating both "Director" and "director" as two separate
//     PROFILE_JOB_TITLE mappings for the same domain is now a real,
//     enforced duplicate (rejected at the DB level) — previously only
//     prevented informally by a query-time case-insensitive match, not a
//     stored/enforced identity.
//   - every other sourceType: an EXACT copy of `microsoftValue`, untouched
//     — preserves today's exact-match semantics byte-for-byte; this column
//     exists there purely so one uniform compound index/query shape covers
//     every sourceType, not because those values are normalized in any way.
// `microsoftValue` itself remains the raw, admin-entered display value —
// never the lookup key on its own anymore.
model MicrosoftDepartmentMapping {
  id                       String                     @id @default(cuid())
  sourceType               MicrosoftMappingSourceType
  microsoftValue           String
  /**
   * "" (global, every non-PROFILE_JOB_TITLE row) or a real Entra domain (PROFILE_JOB_TITLE only) — see this model's header comment.
   */
  domain                   String                     @default("")
  /**
   * Deterministic match key — see this model's header comment for the per-sourceType computation rule.
   */
  normalizedMicrosoftValue String                     @default("")
  department               Department                 @relation(fields: [departmentId], references: [id])
  departmentId             String
  // The GLOBAL role (matches /admin/roles / User.role) — so this dropdown
  // shows exactly the same roles as Roles & Permissions. Required, DB-level
  // placeholder when `globalCustomRole` below is set (mirrors User.role's
  // relationship to User.customRoleId) — see globalCustomRoleId's comment.
  role                     Role                       @default(USER)
  // Custom GLOBAL role (CustomRole.scope GLOBAL/BOTH, isBuiltIn: false) —
  // when set, this is the authoritative Global Role this mapping grants and
  // `role` above just holds the required placeholder USER, exactly
  // mirroring User.customRoleId's relationship to User.role (see that
  // field's schema comment). Nullable/additive: every pre-existing mapping
  // row has this NULL and keeps working unchanged via `role` alone — no
  // backfill needed. onDelete SetNull is a DB-level backstop only; the
  // actual product rule (never silently orphan a mapping) is enforced by
  // blocking CustomRole deletion while referenced — see the DELETE guard in
  // app/api/admin/roles/[id]/route.ts, extended to check this relation too.
  globalCustomRole         CustomRole?                @relation("MicrosoftMappingGlobalCustomRole", fields: [globalCustomRoleId], references: [id], onDelete: SetNull)
  globalCustomRoleId       String?
  // The DepartmentRole granted in `department` above. Explicitly chosen by
  // the admin (no longer derived from `role` at sync time) — see
  // resolveDepartmentMemberships in lib/services/microsoft-mapping-service.ts.
  // DEPARTMENT_ADMIN is deliberately never allowed here (department-scoped
  // analog of Role.ADMIN) — see isDepartmentRoleAllowedForMicrosoftMapping in
  // lib/services/department-role-translation.ts. Required, DB-level
  // placeholder when `departmentCustomRole` below is set.
  departmentRole           DepartmentRole
  // Custom DEPARTMENT role (CustomRole.scope DEPARTMENT/BOTH, isBuiltIn:
  // false) — when set, authoritative for the resulting DepartmentMembership
  // and `departmentRole` above just holds the required placeholder VIEWER,
  // exactly mirroring DepartmentMembership.customRoleId's relationship to
  // DepartmentMembership.role. Same nullable/additive/backward-compatible
  // reasoning as globalCustomRoleId above.
  departmentCustomRole     CustomRole?                @relation("MicrosoftMappingDepartmentCustomRole", fields: [departmentCustomRoleId], references: [id], onDelete: SetNull)
  departmentCustomRoleId   String?
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  usersWithGlobalRoleFromThisMapping User[] @relation("UserGlobalRoleMapping")

  @@unique([sourceType, domain, normalizedMicrosoftValue])
  @@index([departmentId])
  @@index([domain])
  @@index([globalCustomRoleId])
  @@index([departmentCustomRoleId])
}

// Local cache of distinct `department` profile values seen across the
// Microsoft/Entra directory, discovered via an admin-triggered sync (never
// on page render/login) — backs the Microsoft Value dropdown on
// MicrosoftDepartmentMapping so admins select an exact value instead of
// hand-typing it. Rows are never deleted, only marked inactive if a later
// sync no longer sees them, so history isn't lost.
model MicrosoftDirectoryDepartmentValue {
  id          String   @id @default(cuid())
  value       String   @unique
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Started as the same shape/purpose as MicrosoftDirectoryDepartmentValue
// (a distinct `jobTitle` profile value cache backing the Microsoft Value
// dropdown when a MicrosoftDepartmentMapping's sourceType is
// PROFILE_JOB_TITLE — still true, unchanged), then extended for domain-aware
// Job Title auto-discovery (lib/services/microsoft-job-title-directory-service.ts).
//
// CANONICAL IDENTITY is `(domain, normalizedValue)` — enforced by the
// compound unique index below — NOT `value`. `value` is display/source data
// only (the first-seen raw casing/spacing) and is deliberately NOT globally
// unique: the exact same raw text (e.g. "IT Manager") must be able to exist
// once per domain once multiple domains are enabled (kinsen.gr today only,
// via ALLOWED_EMAIL_DOMAIN — see organization-directory-eligibility-service.ts).
// A prior revision of this migration kept a leftover global `@unique` on
// `value` (inherited by copy-paste from MicrosoftDirectoryDepartmentValue,
// which never got this domain extension) — that was a real bug blocking
// exactly this multi-domain scenario, closed by
// 20260807153000_job_title_value_domain_scoped_identity, which drops that
// index without touching any row's data/id.
//   - `domain` + `normalizedValue` + `userCount` are owned by the
//     domain-explicit discovery sync
//     (microsoft-job-title-directory-service.ts's syncMicrosoftJobTitleDirectory
//     and microsoft-directory-service.ts's Operation A/B), which both
//     upsert/lookup exclusively by the compound (domain, normalizedValue)
//     key — ready for a future multi-domain tenant without a further schema
//     change, since each domain gets its own row even when the raw text
//     collides. normalizedValue = trim + collapse-internal-whitespace +
//     lowercase; `value` keeps the first-seen human-readable casing for
//     display only, never used as a lookup/identity key anywhere in the
//     codebase (confirmed by audit — grep for `where: { value` against this
//     model turns up only this file's own header comment and read-only test
//     assertions, both value-non-unique-safe).
// Rows are never deleted, only marked inactive if a later sync no longer
// sees them, so history isn't lost.
model MicrosoftDirectoryJobTitleValue {
  id              String   @id @default(cuid())
  /**
   * Display-only — first-seen raw casing/spacing. NOT unique (see this model's header comment) — (domain, normalizedValue) below is the real identity.
   */
  value           String
  /**
   * Backfilled to the then-current ALLOWED_EMAIL_DOMAIN for every pre-existing row at migration time (see 20260807110000_job_title_directory_domain_scope) — never left blank, since it's part of a unique key.
   */
  domain          String   @default("")
  /**
   * trim + collapse-whitespace + lowercase of `value`; also backfilled at migration time for pre-existing rows.
   */
  normalizedValue String   @default("")
  /**
   * Eligible (@<domain>, userType=Member) users seen with this exact job title as of the last domain-aware sync — 0 for legacy rows never touched by it.
   */
  userCount       Int      @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([domain, normalizedValue])
  @@index([domain])
}

model SubDepartment {
  id           String                    @id @default(cuid())
  name         String
  slug         String?
  description  String?
  isActive     Boolean                   @default(true)
  department   Department                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  // Legacy single-FK relation — kept unchanged (see User.subDepartmentId).
  // SubDepartmentMembership below is the source of truth going forward,
  // mirroring how Department/DepartmentMembership already coexist.
  users        User[]
  memberships  SubDepartmentMembership[]
  tickets      Ticket[]
  projects     Project[]
  activities   ProjectActivity[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
}

// Per-user, per-sub-department standing — mirrors DepartmentMembership's
// shape (source tracking, soft revoke) but deliberately has no role: a
// SubDepartment is an organizational grouping for filtering, not a second
// permission tier. departmentId is denormalized from subDepartment.departmentId
// (validated on write in lib/services/sub-department-membership-service.ts)
// purely for fast filtering, same rationale as other denormalized FKs in
// this schema.
model SubDepartmentMembership {
  id              String           @id @default(cuid())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  subDepartment   SubDepartment    @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  subDepartmentId String
  departmentId    String
  source          MembershipSource
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, subDepartmentId])
  @@index([subDepartmentId])
  @@index([userId])
  @@index([departmentId])
}

// One row per organization-sync attempt (full tenant scan, incremental
// property refresh, or a manager/directReports-only relationship refresh).
// Mirrors EmailPollRun's shape (prisma/schema.prisma, EmailPollRun) but adds
// what that model lacks: an explicit status enum (EmailPollRun only has
// finishedAt/succeeded) — needed here because a run can legitimately finish
// PARTIAL (some bad records skipped) rather than a flat succeeded/failed.
model OrganizationSyncRun {
  id            String                 @id @default(cuid())
  type          OrganizationSyncType
  status        OrganizationSyncStatus @default(RUNNING)
  startedAt     DateTime               @default(now())
  completedAt   DateTime?
  usersScanned  Int                    @default(0)
  usersUpdated  Int                    @default(0)
  usersSkipped  Int                    @default(0)
  errorCount    Int                    @default(0)
  // Sanitized only — never a raw stack trace, never a token/secret value.
  lastError     String?                @db.Text
  deltaLink     String?                @db.Text
  // Admin User.id for a manual "Sync organization" click; null for any
  // future scheduled/automated trigger.
  triggeredById String?

  @@index([startedAt])
  @@index([status])
}

// Singleton row (always id="singleton") used as an atomic compare-and-set
// mutual-exclusion lock so two organization syncs can never run
// concurrently — see acquireOrganizationSyncLock in
// lib/services/organization-sync-orchestrator.ts. There is no locking
// precedent elsewhere in this schema (EmailPollRun has none) so this is
// deliberately its own minimal table rather than overloading another model.
model OrganizationSyncLock {
  id       String    @id @default("singleton")
  isLocked Boolean   @default(false)
  lockedAt DateTime?
  runId    String?
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id                           String                      @id @default(cuid())
  email                        String                      @unique
  emailVerified                DateTime?
  name                         String?
  // Entra `givenName`/`surname` — distinct from `name` (the combined display
  // name, Entra's `displayName`). Optional: only ever populated from
  // Microsoft directory sync (lib/services/organization-directory-sync-service.ts);
  // never required for a credentials-created account.
  givenName                    String?
  surname                      String?
  image                        String?
  // Provenance of `image` — see AvatarSource. Protects a manually-uploaded
  // avatar from ever being silently overwritten by Microsoft sync.
  avatarSource                 AvatarSource?
  // Graph photo ETag from the last successful sync — lets
  // syncMicrosoftProfilePhoto() send If-None-Match and skip a redundant
  // re-download/re-write when the Microsoft photo hasn't actually changed.
  microsoftPhotoEtag           String?
  // When `image` was last written by Microsoft sync — used as an optimistic
  // concurrency guard so a slower/older sync request can never clobber a
  // newer one (see the WHERE microsoftPhotoUpdatedAt < $fetchedAt guard in
  // lib/services/microsoft-profile-photo-service.ts). Distinct from
  // lastMicrosoftSyncAt below, which tracks the unrelated department sync.
  microsoftPhotoUpdatedAt      DateTime?
  role                         Role                        @default(USER)
  isActive                     Boolean                     @default(true)
  // Per-USER (not per-browser) preference — see MentionReminder. Separate from
  // the immediate mention notification and from browser push permission.
  mentionRemindersEnabled      Boolean                     @default(true)
  passwordHash                 String?
  authProvider                 AuthProvider                @default(MICROSOFT)
  mustChangePassword           Boolean                     @default(false)
  // Entra ID `oid` claim — stable identity anchor independent of email, so a
  // user's Microsoft identity survives an email change (see admin email edit).
  microsoftUserId              String?                     @unique
  // Set only on a *successful* Graph-based department sync during Microsoft
  // login (lib/services/microsoft-department-sync-service.ts) — never on a
  // failed fetch, so it always reflects the last time data actually synced.
  lastMicrosoftSyncAt          DateTime?
  // Tracks provenance of the GLOBAL `role` field above, mirroring
  // DepartmentMembership.source's protection model — see GlobalRoleSource.
  globalRoleSource             GlobalRoleSource            @default(SYSTEM)
  globalRoleUpdatedAt          DateTime?
  globalRoleMicrosoftMapping   MicrosoftDepartmentMapping? @relation("UserGlobalRoleMapping", fields: [globalRoleMicrosoftMappingId], references: [id], onDelete: SetNull)
  globalRoleMicrosoftMappingId String?
  company                      Company?                    @relation(fields: [companyId], references: [id])
  companyId                    String?
  businessUnit                 BusinessUnit?               @relation(fields: [businessUnitId], references: [id])
  businessUnitId               String?
  department                   Department?                 @relation(fields: [departmentId], references: [id])
  departmentId                 String?
  subDepartment                SubDepartment?              @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId              String?

  // People/reporting-line hierarchy — deliberately separate from the
  // Department/SubDepartment (organizational-unit) hierarchy above; the two
  // are not guaranteed to align (see docs on the organization-sync feature).
  // Sourced exclusively from Microsoft Graph's manager/directReports
  // navigation properties (lib/services/organization-manager-sync-service.ts)
  // — there is no admin-editable manual override, since Entra is the sole
  // authoritative source for reporting lines per the feature's design.
  manager                 User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerId               String?
  directReports           User[]    @relation("UserManager")
  // True when the most recent manager sync (organization-manager-sync-service.ts,
  // directReports inversion) found this user AS a direct report of some
  // manager in Entra, but that manager was itself excluded from the synced
  // set (guest/service account, invalid record) — so `managerId` above is
  // null NOT because this user has no manager, but because their real
  // manager isn't a usable local row. Distinct from a genuine root (no
  // manager relationship exists in Entra at all) — see
  // lib/services/organization-unmapped-report-service.ts's
  // MANAGER_NOT_SYNCED classification, which reads this flag directly
  // rather than re-deriving it (the signal only exists transiently during a
  // sync run's Graph responses, so it must be persisted here to be
  // reportable afterward without another Graph call).
  managerExcludedFromSync Boolean   @default(false)
  // Entra `employeeId`/`employeeType` — diagnostic/organization-context
  // fields only; not used by any RBAC/department-mapping decision today.
  employeeId              String?
  employeeType            String?
  // Entra `accountEnabled`/`userType` at last sync — distinct from this
  // app's own `isActive` (a TicketApp-local decision, never overwritten by
  // sync). Used only to flag/report a mismatch (e.g. an Entra-disabled
  // account that's still `isActive` locally), never to auto-disable a user.
  entraAccountEnabled     Boolean?
  entraUserType           String?
  // Entra `jobTitle` at last sync — was previously only ever transient
  // (read from Graph at login, used for mapping resolution, then discarded).
  // Stored now so the organization-context API/visualization can display it
  // without an extra Graph call.
  jobTitle                String?
  // Set on every successful organization-sync write for this user (full
  // tenant scan, incremental refresh, or the per-user login-time manager
  // lookup) — distinct from `lastMicrosoftSyncAt` above, which tracks the
  // unrelated department/global-role sync.
  organizationSyncedAt    DateTime?

  customRole   CustomRole? @relation("UserCustomRole", fields: [customRoleId], references: [id])
  customRoleId String?

  departmentMemberships    DepartmentMembership[]
  subDepartmentMemberships SubDepartmentMembership[]

  requestedTickets                    Ticket[]                             @relation("TicketRequester")
  assignedTickets                     Ticket[]                             @relation("TicketAgent")
  departmentChangedTickets            Ticket[]                             @relation("TicketDepartmentChangedBy")
  ticketMessages                      TicketMessage[]
  ticketAttachments                   TicketAttachment[]
  ticketHistories                     TicketHistory[]
  pendingTicketsRequested             PendingTicket[]                      @relation("PendingTicketRequester")
  pendingTicketsAccepted              PendingTicket[]                      @relation("PendingTicketAccepted")
  createdIntegrations                 ExternalIntegration[]                @relation("IntegrationCreatedBy")
  pendingTicketsRejected              PendingTicket[]                      @relation("PendingTicketRejected")
  ownedProjects                       Project[]                            @relation("ProjectOwner")
  projectMemberships                  Project[]                            @relation("ProjectMembers")
  // The FULL, authoritative request-origin Owner set — see Project.owners'
  // own doc comment for the exact "primary vs. full set" relationship with
  // ownedProjects/ownerId above.
  projectOwnerships                   Project[]                            @relation("ProjectOwners")
  // Request-origin Projects this user follows (NOT a Member, NOT an Owner)
  // — see Project.audience's own doc comment.
  projectAudienceOf                   Project[]                            @relation("ProjectAudience")
  projectRequestsSubmitted            ProjectRequest[]                     @relation("ProjectRequestRequester")
  projectRequestsApproved             ProjectRequest[]                     @relation("ProjectRequestApprover")
  submittedProjectFeedback            ProjectFeedback[]                    @relation("ProjectFeedbackSubmitter")
  projectRequestIntermediateApprovals ProjectRequestIntermediateApprover[] @relation("ProjectRequestIntermediateApprover")
  assignedActivities                  ProjectActivity[]                    @relation("ActivityAssignee")
  activityAssignments                 ProjectActivity[]                    @relation("ActivityAssignees")
  createdActivities                   ProjectActivity[]                    @relation("ActivityCreator")
  ownedActivities                     ProjectActivity[]                    @relation("ActivityOwner")
  createdDependencies                 ActivityDependency[]                 @relation("ActivityDependenciesCreatedBy")
  projectNotes                        ProjectNote[]                        @relation("ProjectNoteAuthor")
  activityNotes                       ActivityNote[]                       @relation("ActivityNoteAuthor")
  relatedLinksCreated                 RelatedLink[]                        @relation("RelatedLinkCreator")
  activityAttachments                 ActivityAttachment[]
  projectAttachments                  ProjectAttachment[]
  projectNoteMentions                 ProjectNoteMention[]
  activityNoteMentions                ActivityNoteMention[]
  ticketMessageMentions               TicketMessageMention[]
  ownedGoals                          YearlyGoal[]                         @relation("GoalOwner")
  notifications                       Notification[]
  pushSubscriptions                   PushSubscription[]
  accounts                            Account[]
  sessions                            Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Ticket Config Tables ─────────────────────────────────────────────────────

model TicketCategory {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  color               String                @default("#6366f1")
  isActive            Boolean               @default(true)
  // Always owned by exactly one department — there is no more global/shared
  // category. See the 20260727_retire_global_config migration and
  // scripts/retire-global-config.ts for the one-time data migration that
  // moved every pre-existing global row into a department before this
  // column became required.
  department          Department            @relation(fields: [departmentId], references: [id])
  departmentId        String
  tickets             Ticket[]
  integrationDefaults ExternalIntegration[] @relation("IntegrationDefaultCategory")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([departmentId, name])
}

model TicketPriority {
  id                  String                @id @default(cuid())
  name                String
  level               Int
  color               String
  isActive            Boolean               @default(true)
  // Always owned by exactly one department — there is no more global/shared
  // priority. Mirrors TicketCategory's departmentId. A department-owned
  // priority's SlaPolicy (below) is therefore department-scoped too, with
  // no extra field needed.
  department          Department            @relation(fields: [departmentId], references: [id])
  departmentId        String
  tickets             Ticket[]
  slaPolicy           SlaPolicy?
  integrationDefaults ExternalIntegration[] @relation("IntegrationDefaultPriority")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([departmentId, name])
}

model TicketStatus {
  id           String     @id @default(cuid())
  name         String
  color        String
  // isDefault/isClosed remain simple booleans, per-department: each
  // department marks its own default status. See resolveDefaultStatusId in
  // lib/services/department-scope-service.ts.
  isDefault    Boolean    @default(false)
  isClosed     Boolean    @default(false)
  isActive     Boolean    @default(true)
  order        Int        @default(0)
  // Always owned by exactly one department — there is no more global/shared
  // status. Mirrors TicketCategory.
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  tickets      Ticket[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, name])
}

model TicketCancelReason {
  id           String      @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean     @default(true)
  // Nullable = global/shared reason visible to every department (existing
  // rows); non-null = owned by one department. Mirrors TicketCategory.
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  tickets      Ticket[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([departmentId, name])
}

// ─── Tickets ──────────────────────────────────────────────────────────────────

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber Int          @unique @default(autoincrement())
  title        String
  description  String       @db.Text
  source       TicketSource @default(WEB)

  requester       User                @relation("TicketRequester", fields: [requesterId], references: [id])
  requesterId     String
  assignedAgent   User?               @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  assignedAgentId String?
  department      Department?         @relation(fields: [departmentId], references: [id])
  departmentId    String?
  // Must belong to the same departmentId as this ticket — validated in
  // lib/services/sub-department-service.ts, not enforced at the DB level.
  subDepartment   SubDepartment?      @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId String?
  category        TicketCategory?     @relation(fields: [categoryId], references: [id])
  categoryId      String?
  priority        TicketPriority?     @relation(fields: [priorityId], references: [id])
  priorityId      String?
  status          TicketStatus        @relation(fields: [statusId], references: [id])
  statusId        String
  cancelReason    TicketCancelReason? @relation(fields: [cancelReasonId], references: [id])
  cancelReasonId  String?

  emailMessageId String? @unique
  emailThreadId  String?

  project    Project?         @relation(fields: [projectId], references: [id])
  projectId  String?
  activity   ProjectActivity? @relation(fields: [activityId], references: [id])
  activityId String?

  // Ticket-only sharing (never Project/Activity): a non-full-view department
  // member (see splitTicketViewScope in department-scope-service.ts) only
  // sees their own tickets by default — these flags opt a specific ticket
  // into being visible to every active member of its Department/
  // SubDepartment too. Enforced centrally in buildTicketListWhere/
  // canViewTicket, never as a page-local filter.
  shareWithDepartment    Boolean @default(false)
  shareWithSubDepartment Boolean @default(false)

  // Who last moved this ticket's Department/SubDepartment, and when — set
  // only by PATCH /api/tickets/[id]/department. Denormalized alongside the
  // full audit trail in TicketHistory (type: DEPARTMENT_CHANGE) so All
  // Tickets can show "changed by" without a per-ticket history lookup.
  departmentChangedBy   User?     @relation("TicketDepartmentChangedBy", fields: [departmentChangedById], references: [id], onDelete: SetNull)
  departmentChangedById String?
  departmentChangedAt   DateTime?

  messages    TicketMessage[]
  attachments TicketAttachment[]
  history     TicketHistory[]

  // Set only when this ticket originated from an accepted PendingTicket —
  // see acceptPendingTicket in lib/services/pending-ticket-service.ts. Never
  // set for WEB-created or directly-appended-reply tickets.
  pendingTicketOrigin PendingTicket?

  // Set only for source: API tickets — see POST /api/integrations/tickets
  // and lib/services/ticket-creation-service.ts. onDelete: Restrict
  // (explicit override of the implicit SetNull an optional relation would
  // otherwise get) is deliberate: an ExternalIntegration with tickets
  // attached to it can never be hard-deleted out from under them, so a
  // ticket's "which application created this" provenance can never be
  // silently lost — see the ExternalIntegration model's own doc comment.
  // Disabling (isActive: false) is the supported way to retire an
  // integration; deletion is intentionally not exposed by any admin route.
  integration         ExternalIntegration? @relation("IntegrationTickets", fields: [integrationId], references: [id], onDelete: Restrict)
  integrationId       String?
  // The calling application's own idempotency key for the business event
  // that created this ticket — always set together with integrationId,
  // never independently. See the @@unique constraint below, which is the
  // actual duplicate-ticket guard (not an application-level check alone).
  externalReferenceId String?
  // Deep link back to the exact screen/record in the source application —
  // validated against ExternalIntegration.baseUrl's origin at creation time
  // (see the endpoint), but stored as-is (full URL) since baseUrl itself is
  // optional and a ticket must still remember its own link either way.
  sourceUrl           String?
  // Arbitrary caller-supplied structured context (e.g. { vehicleId, plate,
  // environment }) — opaque to TicketApp beyond a server-side size cap
  // enforced at write time (see the endpoint's validation); rendered as a
  // compact key/value list in the UI, never dumped as raw HTML.
  externalMetadata    Json?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([integrationId, externalReferenceId])
  @@index([requesterId])
  @@index([assignedAgentId])
  @@index([statusId])
  @@index([priorityId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@index([createdAt])
  @@index([projectId])
  @@index([activityId])
  @@index([shareWithDepartment])
  @@index([shareWithSubDepartment])
  @@index([departmentChangedById])
  @@index([integrationId])
}

// ─── External Integrations ─────────────────────────────────────────────────────
//
// One row per external application allowed to create real Tickets directly
// via POST /api/integrations/tickets (server-to-server, API-key
// authenticated — never a browser session/NextAuth cookie). Deliberately
// NOT a User/session-based principal: an integration is a scoped credential,
// not a person, so it never appears as a Ticket.requesterId — the real
// human who hit the problem is resolved separately per-request from the
// request body's requesterEmail (see resolveOrCreateRequester in
// lib/services/requester-resolution-service.ts).
//
// Every integration is pinned to exactly one Department at creation time —
// the incoming request can never choose or override this (see the
// endpoint's Zod schema, which doesn't even accept a departmentId field) —
// so a leaked/misused key's blast radius is a single department's ticket
// queue, never "any department in the system."
model ExternalIntegration {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  department   Department @relation("IntegrationDepartment", fields: [departmentId], references: [id])
  departmentId String

  // Applied only when the incoming request omits its own categoryId/
  // priorityId (or the incoming value fails department-ownership/active
  // validation) — see resolveIntegrationTicketDefaults in
  // lib/services/ticket-creation-service.ts. SetNull (not Restrict): a
  // department admin deleting a category/priority that happens to be an
  // integration's configured default must still succeed — the integration
  // just falls back to resolveDefaultStatusId-style department defaults
  // (priority) or no category at all, exactly as if it had never set one.
  defaultCategory   TicketCategory? @relation("IntegrationDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  defaultCategoryId String?
  defaultPriority   TicketPriority? @relation("IntegrationDefaultPriority", fields: [defaultPriorityId], references: [id], onDelete: SetNull)
  defaultPriorityId String?

  // Optional — when set, an incoming sourceUrl must share this exact origin
  // (scheme + host + port, real URL parsing, never string prefix matching —
  // see the endpoint). Left null, no origin check is enforced on sourceUrl.
  baseUrl String?

  // The raw API key is never stored — only enough to identify (prefix, for
  // an O(1) indexed lookup with no ambiguity, since it's @unique) and verify
  // (hash, compared with a constant-time algorithm) it. See
  // lib/services/integration-key-service.ts for generation/hashing/
  // verification — the raw value is shown to an admin exactly once, at
  // creation or rotation time, and never persisted or logged anywhere.
  apiKeyPrefix String @unique
  apiKeyHash   String
  // Optimistic-concurrency token for key rotation only (not read/checked by
  // the ticket-creation auth path at all — that's by hash comparison).
  // Incremented atomically by the rotate route's compare-and-swap update
  // (WHERE id = ... AND keyVersion = <version read at the start of the
  // request>). Two admins rotating the same integration at the same instant
  // can no longer both "win": whichever request's conditional UPDATE
  // matches zero rows loses the race and returns a controlled 409 with no
  // raw key, instead of silently generating and displaying a key that next
  // never actually becomes valid (a real gap found and fixed after an
  // external hardening audit — see integration-key-rotation-conflict in the
  // rotate route).
  keyVersion   Int    @default(1)

  lastUsedAt DateTime?

  createdBy   User?   @relation("IntegrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[] @relation("IntegrationTickets")

  @@index([departmentId])
  @@index([isActive])
}

// ─── Pending Tickets (Department Email → Pending review flow) ─────────────────
//
// Inbound email never creates a real Ticket directly anymore — it creates a
// PendingTicket, which only becomes a real Ticket (via acceptPendingTicket in
// lib/services/pending-ticket-service.ts) once a permissioned reviewer
// Accepts it. Rejecting is a soft update (status: REJECTED) — the row is
// kept for audit and never produces a Ticket. Deliberately a separate table,
// not a flag on Ticket: every existing Ticket query (buildTicketListWhere,
// GET /api/tickets, TicketTable) stays completely unaware this flow exists,
// so a pending row can never leak into "All Tickets" by omission.
enum PendingTicketStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PendingTicket {
  id     String              @id @default(cuid())
  status PendingTicketStatus @default(PENDING)

  // Real DB-unique dedup key (stronger than TicketMessage.emailMessageId's
  // app-level findFirst check, which stays for reply-append dedup) — see
  // processInboundEmails in lib/ticket-email-service.ts.
  emailMessageId String   @unique
  emailThreadId  String?
  fromEmail      String
  fromName       String?
  subject        String
  body           String   @db.Text
  receivedAt     DateTime

  // Resolved from the message's recipient(s) against Department.inboundEmail
  // at receipt time (see matchDepartmentForRecipients) — null means no
  // department address matched; visible only to Admin/Director in
  // /tickets/pending until accepted with an explicitly chosen department.
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId String?
  requester    User?       @relation("PendingTicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterId  String?

  attachments PendingTicketAttachment[]

  acceptedTicket   Ticket?   @relation(fields: [acceptedTicketId], references: [id], onDelete: SetNull)
  acceptedTicketId String?   @unique
  acceptedBy       User?     @relation("PendingTicketAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedById     String?
  acceptedAt       DateTime?
  rejectedBy       User?     @relation("PendingTicketRejected", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedById     String?
  rejectedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([requesterId])
}

model PendingTicketAttachment {
  id              String        @id @default(cuid())
  pendingTicket   PendingTicket @relation(fields: [pendingTicketId], references: [id], onDelete: Cascade)
  pendingTicketId String

  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String

  createdAt DateTime @default(now())

  @@index([pendingTicketId])
}

model TicketMessage {
  id       String  @id @default(cuid())
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?
  body     String  @db.Text

  direction  MessageDirection @default(OUTBOUND)
  isInternal Boolean          @default(false)

  // Real DB-unique dedup key (Postgres allows any number of NULL rows under
  // a unique index — only ever set for an email-originated reply, so
  // in-app-composed messages, which leave this null, are unaffected) — see
  // the concurrent-processing note in processInboundEmails
  // (lib/ticket-email-service.ts): two overlapping poll runs (e.g. a manual
  // "Poll Now" click racing a scheduled poll) both attempting to append the
  // same reply now fail one of them at the DB with P2002, caught and treated
  // as a safe duplicate-skip, not a broken run. Confirmed zero pre-existing
  // duplicate/non-null values before adding this constraint.
  emailMessageId String? @unique
  fromEmail      String?
  fromName       String?

  attachments TicketAttachment[]
  mentions    TicketMessageMention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
}

// A structured @mention of a User inside an internal TicketMessage note
// (isInternal: true — see that field's own doc comment; this is never
// created for a public/requester-facing reply). Mirrors ProjectNoteMention/
// ActivityNoteMention below — three small, entity-appropriate join tables
// instead of one polymorphic "NoteMention" table, because ProjectNote/
// ActivityNote/TicketMessage are three distinct models with no unified
// "Note" table to hang a single FK off of; forcing that unification just for
// this feature was explicitly out of scope. The shared mention SERVICE/API/
// UI (lib/services/mention-service.ts, components/notes/mention-textarea.tsx)
// is what stays single-implementation, not the storage table. onDelete:
// Cascade on both FKs — deleting the message or the mentioned user removes
// the mention row; a mention is never meaningful on its own.
model TicketMessageMention {
  id        String        @id @default(cuid())
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime      @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model TicketAttachment {
  id           String         @id @default(cuid())
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  message      TicketMessage? @relation(fields: [messageId], references: [id])
  messageId    String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime       @default(now())

  @@index([ticketId])
}

model TicketHistory {
  id          String            @id @default(cuid())
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  changedBy   User?             @relation(fields: [changedById], references: [id])
  changedById String?
  type        TicketHistoryType
  oldValue    String?
  newValue    String?
  description String?
  createdAt   DateTime          @default(now())

  @@index([ticketId])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id               String          @id @default(cuid())
  title            String
  description      String?         @db.Text
  status           ProjectStatus   @default(PLANNING)
  priority         Int             @default(2)
  progress         Int             @default(0)
  // The single CANONICAL/PRIMARY owner — kept for every pre-existing
  // consumer that only ever needed one (filters, the owner-grouped
  // dashboard chart, list/detail display, seed data): NEVER nullable,
  // NEVER auto-derived. For a manual Project this is (as always) the
  // creator. For a request-origin Project this is simply the FIRST user
  // the creator explicitly selected in Owner(s) at Project Setup — always
  // a member of `owners` below, never a user who wasn't explicitly chosen.
  // `owners` (not this field) is the authoritative FULL owner set — see
  // its own doc comment for why both exist and how they relate.
  owner            User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId          String
  department       Department?     @relation(fields: [departmentId], references: [id])
  departmentId     String?
  // Must belong to the same departmentId as this project — validated in
  // lib/services/sub-department-service.ts, not enforced at the DB level.
  subDepartment    SubDepartment?  @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId  String?
  // Set only when this Project was created through the request-origin setup
  // flow for an APPROVED Project Request (see
  // createProjectFromApprovedRequest in
  // lib/services/project-request-service.ts, and
  // POST /api/project-requests/[id]/project) — null for every
  // manually-created Project. @unique enforces at most one Project per
  // request; combined with that route's own race-guarded transaction, this
  // makes the creation naturally idempotent (a concurrent duplicate
  // submission can never produce two Projects for the same request).
  projectRequest   ProjectRequest? @relation(fields: [projectRequestId], references: [id])
  projectRequestId String?         @unique
  businessUnit     BusinessUnit?   @relation(fields: [businessUnitId], references: [id])
  businessUnitId   String?
  startDate        DateTime?
  endDate          DateTime?
  successTarget    String?         @db.Text
  isGoal           Boolean         @default(false)

  // ─── Request-origin-only metadata (section 6/7 of the Project Request →
  // Project setup feature) — all nullable at the DB level since manual
  // Projects, legacy Projects, and the OLD auto-created-on-approval
  // Projects from before this feature never have real historical values
  // for these; the mandatory-at-creation guarantee for a NEW request-origin
  // Project lives entirely at the application boundary
  // (createProjectFromApprovedRequest), never at the schema level. Deliberately
  // separate from the pre-existing startDate/endDate above — those keep
  // their original Gantt/filter/overdue semantics untouched; these are
  // purely additional planning metadata.
  expectedStartDate        DateTime?
  expectedFinishDate       DateTime?
  // The INITIAL baseline duration (expectedFinishDate - expectedStartDate,
  // whole calendar days), computed server-side ONCE at creation and never
  // silently recalculated if Expected Start/Finish are edited later — see
  // createProjectFromApprovedRequest's own doc comment for the exact
  // calculation and PATCH /api/projects/[id] for why it's never accepted
  // as client input on update.
  expectedTotalInitialDays Int?
  expenseType              ProjectExpenseType? @relation(fields: [expenseTypeId], references: [id])
  expenseTypeId            String?
  // Budget, and the old user-entered Estimated/Actual Cost columns, were
  // REMOVED here (see
  // prisma/migrations/.../remove_project_budget_and_cost_columns) — all
  // three existed solely for this request-origin feature (confirmed: no
  // other Project feature ever read/wrote them) and are now fully derived,
  // never stored: Project Estimated/Actual Cost are computed fresh from the
  // CURRENT state of this Project's own Activities every time they're read
  // (see lib/services/project-financials-service.ts's
  // computeProjectFinancials — the single authoritative aggregation),
  // avoiding any possibility of the displayed total drifting from the
  // Activities that actually make it up. Budget has no replacement — the
  // business rule simply no longer tracks it for request-origin Projects.
  external                 Boolean             @default(false)

  members      User[]              @relation("ProjectMembers")
  // The AUTHORITATIVE full Owner set — always contains `ownerId` (the
  // canonical/primary one, see its own doc comment above). For EVERY
  // Project (manual or request-origin) this mirrors reality exactly: a
  // manual Project always has exactly one entry (the same single creator/
  // owner it always had — nothing observable changes for manual Projects,
  // this is purely an internal consistency invariant so "owners always
  // contains ownerId" holds universally, with no per-origin special-
  // casing needed anywhere that reads it). A request-origin Project has
  // whichever one-or-more users the creator explicitly selected at Project
  // Setup (see createProjectFromApprovedRequest) — NEVER auto-assigned,
  // NEVER silently derived. Deliberately NOT `members` — an Owner is not
  // automatically a Member, and vice versa (see PROJECT_OWNER_AUDIENCE
  // feature's own spec: "Do not use Members as storage for Owners").
  owners       User[]              @relation("ProjectOwners")
  // Users who may follow/view a request-origin Project's progress without
  // being a Member or an Owner — see hasProjectViewAccess
  // (lib/services/project-access-service.ts), the ONLY place Audience
  // membership has any effect: it extends READ access to the Project
  // detail/notes/attachments surfaces, nothing else — never edit/delete,
  // never Member/Owner status. Always empty for a manual Project (never
  // written to outside the request-origin creation path). Zero or more,
  // system-wide (never Department/Workspace-scoped, unlike `members`).
  audience     User[]              @relation("ProjectAudience")
  activities   ProjectActivity[]
  tickets      Ticket[]
  yearlyGoals  YearlyGoal[]        @relation("GoalProjects")
  notes        ProjectNote[]
  relatedLinks RelatedLink[]
  attachments  ProjectAttachment[]
  // At most one — see ProjectFeedback's own doc comment for the full
  // eligibility/uniqueness rule (request-origin Projects only, one
  // editable-by-its-original-requester row per Project, enforced via
  // @unique on ProjectFeedback.projectId).
  feedback     ProjectFeedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@index([expenseTypeId])
  // Matches Ticket's own @@index([createdAt]) — app/(main)/projects/page.tsx
  // (and the Projects Dashboard) always order by createdAt desc, id asc, the
  // same pagination-ordering pattern Ticket already has this index for.
  @@index([createdAt])
}

// Feedback the ORIGINAL Project Request requester submits evaluating a
// delivered, request-origin Project — applies ONLY to a Project where
// Project.projectRequestId != null (enforced at the application boundary,
// POST /api/projects/[id]/feedback — never trusted from this schema
// alone). At most one row per Project (@unique below) — the original
// requester may UPDATE their own existing row rather than ever creating a
// second one (see upsertProjectFeedback in
// lib/services/project-feedback-service.ts); reopening the Project later
// never deletes an already-submitted row, it only blocks further edits
// until the Project is COMPLETED again.
//
// Replaced a single 1-10 satisfactionScore with five independent 1-5
// ratings + a separate explicit requirementsDelivered boolean (see
// projectFeedbackSchema in lib/validations.ts and the Greek-labeled
// ProjectFeedbackCard form) — see legacySatisfactionScore below for how
// pre-existing historical rows are preserved, never fabricated into the
// new five-rating shape.
model ProjectFeedback {
  id String @id @default(cuid())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @unique

  // Denormalized from Project.projectRequestId at submission time — lets
  // the Administration review list (app/(main)/admin/project-feedback)
  // join straight to the originating request without going through
  // Project first. Set ONCE, by the same server check that verifies
  // eligibility (upsertProjectFeedback) — never re-derived afterward.
  // @unique here too (not just on projectId) because it's transitively
  // true anyway (Project.projectRequestId is itself @unique, so one
  // Project Request has at most one Project, which has at most one
  // ProjectFeedback) — declaring it explicitly lets ProjectRequest's own
  // `feedback ProjectFeedback?` back-relation be a real one-to-one.
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id])
  projectRequestId String         @unique

  // The original Project Request's own requesterId — the ONLY identity
  // ever allowed to create OR update this row. Never client-supplied: set
  // from the authenticated session only after the server has independently
  // confirmed session.user.id === projectRequest.requesterId.
  submittedByUser   User   @relation("ProjectFeedbackSubmitter", fields: [submittedByUserId], references: [id])
  submittedByUserId String

  // The FIVE independent 1-5 ratings (see projectFeedbackSchema in
  // lib/validations.ts for the exact integer 1-5 constraint, re-validated
  // server-side on every write — never trusted from the DB type alone).
  // Nullable at the DB level ONLY because a pre-existing row submitted
  // under the old single-score model can never be safely backfilled with
  // fabricated per-dimension values — required at the application
  // boundary for every NEW submission going forward, the same
  // "nullable at DB, required at creation" pattern this schema already
  // uses throughout (e.g. TaskSubType.cost, ProjectActivity.taskTypeId).
  deliverySpeedRating Int?
  communicationRating Int?
  functionalityRating Int?
  easeOfUseRating     Int?
  overallRating       Int?
  // A separate, explicit boolean answer — never derived from the five
  // ratings above. Same DB-nullable/application-required rationale as the
  // five ratings.
  requirementsDelivered Boolean?

  // Optional free text, trimmed server-side; an empty/whitespace-only
  // submission normalizes to null rather than an empty string. Unchanged
  // by the replacement — the SAME field/meaning the old model already
  // used, reused as-is by the new form.
  comments String? @db.Text

  // The OLD 1-10 satisfactionScore, renamed and made nullable — preserves
  // every historical submission's real value forever (never dropped, never
  // reinterpreted as one of the five new ratings, since no truthful
  // per-dimension breakdown can be derived from a single historical
  // score). Every row created under the new model leaves this null
  // forever; it is never written to by upsertProjectFeedback.
  legacySatisfactionScore Int?

  createdAt DateTime @default(now())
  // NEW — feedback is now an editable record (the original requester may
  // update their own submission while the Project is COMPLETED), not a
  // permanently immutable one-shot answer.
  updatedAt DateTime @updatedAt

  @@index([submittedByUserId])
}

model ProjectActivity {
  id                 String               @id @default(cuid())
  title              String
  description        String?              @db.Text
  status             ActivityStatus       @default(TODO)
  priority           ActivityPriority     @default(MEDIUM)
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId          String?
  assignedUser       User?                @relation("ActivityAssignee", fields: [assignedUserId], references: [id])
  assignedUserId     String?
  assignedUsers      User[]               @relation("ActivityAssignees")
  createdBy          User?                @relation("ActivityCreator", fields: [createdById], references: [id])
  createdById        String?
  department         Department?          @relation(fields: [departmentId], references: [id])
  departmentId       String?
  // Must belong to the same departmentId as this activity — validated in
  // lib/services/sub-department-service.ts, not enforced at the DB level.
  subDepartment      SubDepartment?       @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId    String?
  businessUnit       BusinessUnit?        @relation(fields: [businessUnitId], references: [id])
  businessUnitId     String?
  startDate          DateTime?
  dueDate            DateTime?
  progress           Int                  @default(0)
  isMilestone        Boolean              @default(false)
  completedAt        DateTime?
  isCompleted        Boolean              @default(false)
  // ─── Request-origin-only Activity metadata ──────────────────────────────
  // Only ever REQUIRED at creation when the parent Project itself
  // originates from a Project Request (Project.projectRequestId != null) —
  // see createActivitySchema/requestOriginActivitySchema in
  // lib/validations.ts. Every field below is nullable at the DB level
  // because legacy Activities (predating this feature, or belonging to a
  // normal/manual Project) never have it filled in — never fabricated,
  // never backfilled.
  //
  // owner is a SEPARATE, NEW single-user field, deliberately NOT a reuse of
  // the legacy singular `assignedUser` above (that field is unused/stale —
  // repurposing it would be silently reinterpreting an unrelated field).
  // Named after Project's own owner/ownerId for consistency.
  owner              User?                @relation("ActivityOwner", fields: [ownerId], references: [id])
  ownerId            String?
  // "Related Users" reuses the EXISTING `assignedUsers` many-to-many above
  // (already the canonical "who is assigned to this activity" relation,
  // used everywhere — Gantt, Resource Planning, lists) — see this
  // feature's own doc comment in lib/validations.ts for why no parallel
  // relation was added. The "at least one required" rule is enforced only
  // at the request-origin creation boundary, not as a DB constraint (a
  // manual Activity may still have zero assignees, exactly as today).
  expectedStartDate  DateTime?
  expectedFinishDate DateTime?
  // Whole calendar days (expectedFinishDate - expectedStartDate),
  // RECALCULATED server-side any time either date legitimately changes —
  // unlike Project.expectedTotalInitialDays, this is NOT an immutable
  // creation-time baseline. Null whenever either date is missing (e.g. a
  // legacy/grandfathered record with only one of the two set).
  expectedDays       Int?
  // Whole calendar days (completion date - expectedStartDate), computed
  // ONCE at the authoritative COMPLETED transition (see
  // app/api/activities/route.ts and app/api/activities/[id]/route.ts).
  // Null until the Activity is actually completed; null forever if
  // expectedStartDate was never set (legacy record). Cleared back to null
  // if the Activity is reopened away from COMPLETED, and recomputed from
  // the NEW completion date if completed again later.
  actualDays         Int?
  // The NEW Task Type classification (formerly ProjectRequestType /
  // "Project Type" on ProjectRequest — see TaskType's own doc comment for
  // the full move). REQUIRED at the application boundary for every NEW
  // Activity creation (see createActivitySchema in lib/validations.ts and
  // POST /api/activities's own server-side re-validation) — nullable here
  // ONLY because every Activity created before this field existed can
  // never be safely backfilled with a fabricated choice, the same
  // "nullable at DB, required at creation" pattern every other
  // request-origin-only field on this model already uses. Has NO cost of
  // its own (see TaskType — unlike TaskSubType below, which does).
  taskType           TaskType?    @relation(fields: [taskTypeId], references: [id])
  taskTypeId         String?
  // The RENAMED former "Task Type" (now Task Sub Type — see TaskSubType's
  // own doc comment) — same field, same meaning, same historical values,
  // only the column/relation NAME changed (was taskType/taskTypeId) to
  // free that name up for the brand-new, unrelated field above. Business
  // semantics (required only for request-origin Activities) are
  // completely unchanged by this rename.
  taskSubType        TaskSubType? @relation(fields: [taskSubTypeId], references: [id])
  taskSubTypeId      String?
  // A HISTORICAL SNAPSHOT of taskSubType.cost at the moment it was set on
  // this Activity (at creation, or whenever Task Sub Type is CHANGED
  // during edit) — never recalculated just because the admin later
  // changes the Task Sub Type's own current cost (renamed from
  // taskTypeCost, same values, same semantics). When the selected Task
  // Sub Type has NO configured cost (cost = null), this snapshot is also
  // null — NEVER coerced to 0; see
  // lib/services/project-financials-service.ts for how financial totals
  // treat a null snapshot as "no fixed calculable cost," not a zero cost.
  taskSubTypeCost    Decimal?     @db.Decimal(10, 2)
  // The user-controlled execution/priority ORDER of this Activity within
  // its parent Project's vertical sequence — request-origin Projects only
  // (Project.projectRequestId != null; see
  // lib/services/activity-sequence-service.ts, the single authoritative
  // place this field is ever read or written). Always a contiguous 1..N
  // per Project after this feature's own reorder/create/delete/move paths
  // run (never duplicates, never gaps) — nullable purely because a
  // standalone Activity or one under a manual Project never has it set at
  // all (ordering is meaningless there; the existing Activity list simply
  // ignores this field for them). Pure ORDERING — carries no dependency/
  // blocking semantics; see ActivityDependency above for this repo's
  // actual (separate, currently unused by any UI) dependency-graph model,
  // which this field is never confused with or derived from.
  sequence           Int?
  tickets            Ticket[]
  predecessorDeps    ActivityDependency[] @relation("ActivityDependencyPredecessor")
  successorDeps      ActivityDependency[] @relation("ActivityDependencySuccessor")
  notes              ActivityNote[]
  relatedLinks       RelatedLink[]
  attachments        ActivityAttachment[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([projectId])
  @@index([assignedUserId])
  @@index([createdById])
  @@index([status])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@index([ownerId])
  @@index([taskTypeId])
  @@index([taskSubTypeId])
  // Matches Ticket's own @@index([createdAt]) — app/(main)/activities/page.tsx
  // orders by createdAt desc, id asc, the same pattern Ticket already has
  // this index for.
  @@index([createdAt])
  // Supports the request-origin Project detail page's own ORDER BY
  // (projectId, sequence) — see activity-sequence-service.ts.
  @@index([projectId, sequence])
}

// Global reference data (not department-scoped) — formerly named
// "ActivityTaskType" / surfaced as "Task Type"; renamed to "Task Sub Type"
// once the UNRELATED, former ProjectRequestType concept took over the name
// "Task Type" for Activities (see TaskType below). Same reference-data
// shape/pattern ProjectExpenseType mirrors (id, name, isActive,
// timestamps). Managed through its own dedicated permission (the KEY
// itself, `taskType.manage`, is intentionally UNCHANGED by this rename —
// renaming a Permission.key would silently orphan every existing
// RolePermission grant referencing that exact string; only its
// human-readable description was updated — see prisma/seed.ts's
// PERMISSIONS), never bare "admin access".
//
// cost is now OPTIONAL (was required before this rename) — some Task Sub
// Types (e.g. "Others", "External") genuinely have no fixed predefined
// cost; `null` means exactly that, never coerced to 0 anywhere downstream
// (see ProjectActivity.taskSubTypeCost's own doc comment, and
// lib/services/project-financials-service.ts).
model TaskSubType {
  id         String            @id @default(cuid())
  name       String            @unique
  cost       Decimal?          @db.Decimal(10, 2)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  activities ProjectActivity[]
}

// Global reference data (not department-scoped) — formerly named
// "ProjectRequestType" / surfaced as "Project Type" on ProjectRequest; this
// concept moved OFF ProjectRequest entirely and became an Activity
// classification instead (see ProjectActivity.taskType below). The
// `projectRequests` back-relation is kept ONLY for historical rows already
// submitted before this change (see ProjectRequest.projectTypeId's own doc
// comment) — a NEW Project Request never sets it. Permission key
// `projectRequestType.manage` is intentionally UNCHANGED for the same
// orphaned-grant reason as TaskSubType above; only its description changed.
model TaskType {
  id              String            @id @default(cuid())
  name            String            @unique
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  projectRequests ProjectRequest[]
  activities      ProjectActivity[]
}

// A ProjectNote is an authenticated user's plain internal collaboration note
// attached to a Project — NOT a ticket-style reply/message. Deliberately has
// none of TicketMessage's communication-channel concepts (direction,
// isInternal, emailMessageId, fromEmail/fromName, attachments): a note is
// always internal, always plain text, never emailed, never part of a
// requester-facing conversation. See components/notes/ for the shared
// read/create UI and app/api/projects/[id]/notes/route.ts for the
// authoritative create/read rules (project.view to read, project.edit to
// write — no separate `project.note` permission is introduced).
model ProjectNote {
  id        String               @id @default(cuid())
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  author    User?                @relation("ProjectNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  body      String               @db.Text
  mentions  ProjectNoteMention[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([projectId, createdAt])
}

// A structured @mention of a User inside a ProjectNote — see
// TicketMessageMention's doc comment for the shared design rationale (three
// small entity-appropriate join tables, one shared mention service/UI).
model ProjectNoteMention {
  id        String           @id @default(cuid())
  note      ProjectNote      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime         @default(now())
  reminder  MentionReminder?

  @@unique([noteId, userId])
  @@index([userId])
}

// Same concept as ProjectNote, for a ProjectActivity — see that model's own
// doc comment for what this deliberately does NOT contain.
model ActivityNote {
  id         String                @id @default(cuid())
  activity   ProjectActivity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  author     User?                 @relation("ActivityNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  body       String                @db.Text
  mentions   ActivityNoteMention[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([activityId, createdAt])
}

// A structured @mention of a User inside an ActivityNote — see
// TicketMessageMention's doc comment for the shared design rationale.
model ActivityNoteMention {
  id        String           @id @default(cuid())
  note      ActivityNote     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime         @default(now())
  reminder  MentionReminder?

  @@unique([noteId, userId])
  @@index([userId])
}

// Reuses the exact private-storage architecture already built for
// TicketAttachment (see lib/attachment-policy.ts: private UPLOAD_DIR,
// MIME/size allowlist, path-traversal guards) — deliberately NOT under
// public/, so a file is only ever readable through the authenticated GET
// /api/activities/[id]/attachments/[attachmentId] route (which reconstructs
// the on-disk location from UPLOAD_DIR + activityId + filename, never from
// a stored path column). No `messageId`/`message` field: unlike a
// TicketAttachment, an ActivityAttachment is never tied to a specific
// conversation message — Activities have no message/reply concept (same as
// ActivityNote above). Upload/delete require activity.edit; view/download
// require activity.view — both resolved per-activity via canActOnEntity,
// exactly like every other Activity sub-resource (notes, dependencies).
model ActivityAttachment {
  id           String          @id @default(cuid())
  activity     ProjectActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId   String
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())

  @@index([activityId])
}

// Project's own counterpart of ActivityAttachment above — deliberately an
// ADDITIVE, separate model rather than a generalized/polymorphic
// "EntityAttachment" table: ActivityAttachment already has real production
// rows keyed on a required `activityId`, and turning it polymorphic would
// mean making that column nullable, adding a projectId column, and a CHECK
// constraint (the RelatedLink "exactly one owner" pattern) purely for
// naming symmetry — a real migration/backfill risk this task explicitly
// avoids. What IS shared: the storage policy (lib/attachment-policy.ts),
// the route-handler logic (lib/attachments/route-handlers.ts), and the UI
// (components/attachments/entity-attachments.tsx) — only the Prisma model
// and the on-disk subdirectory ("projects/<id>" vs "activities/<id>") are
// duplicated, by design. Upload/delete require project.edit; view/download
// require project.view — both resolved via hasEffectiveEntityPermission
// against the Project's own real departmentId, exactly like
// ActivityAttachment. Project deletion cascades this table the same way
// Activity deletion cascades ActivityAttachment — DB rows only; the on-disk
// files are left behind exactly like Activity deletion already leaves
// ActivityAttachment's files behind (no existing cleanup to diverge from).
model ProjectAttachment {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([uploadedById])
}

// ─── Project Request Form (separate business entity — NEVER auto-creates a
// real Project; see the "Create Project from approved request" note below) ──

// A configurable classification for a Project's EXPENSE TYPE — e.g. "CapEx",
// "OpEx", "Maintenance". A single, global, admin-managed list (not
// department-scoped — same rationale as TaskType above), offered
// only to Projects created through the request-origin setup flow (see
// createProjectFromApprovedRequest). Deactivating a type here only hides it
// from the setup form's dropdown (the isActive filter in
// GET /api/project-expense-types) — it never deletes or relabels any
// Project that already references it, so a Project created against a since-
// deactivated Expense Type keeps displaying it correctly forever, matching
// the same "soft delete" convention TaskType/TicketStatus/
// TicketPriority/TicketCategory already use for their own isActive flag.
// Hard delete (DELETE /api/admin/project-expense-types/[id]) is blocked
// while any Project still references it — see that route's own doc comment.
model ProjectExpenseType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

enum ProjectRequestStatus {
  // The requester-selected set of intermediate approvers (see
  // ProjectRequestIntermediateApprover) must ALL approve, unanimously,
  // before this status can ever advance to PENDING_APPROVAL. Any ONE of
  // them rejecting moves the request straight to REJECTED. New requests
  // default here; legacy rows created before this stage existed were never
  // retroactively moved back to this status (see this enum's own migration
  // — additive only, no backfill).
  PENDING_INTERMEDIATE_APPROVAL
  // The pre-existing single, department-scoped final stage — completely
  // unchanged by the intermediate stage's addition. A request only reaches
  // this status once every selected intermediate approver has approved.
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum IntermediateApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A user-submitted request to start a new Project, routed through a SINGLE
// department-scoped approval stage before anyone is authorized to act on
// it — see lib/services/project-request-service.ts for the full state
// machine. Approval is never tied to the requester's own org-chart manager;
// it's ANY user who holds effective `projectRequest.approve` for this
// request's own department (global grant, or that department's own
// grant — same union project.edit/gantt.view already use). This model is
// intentionally NOT linked to Project at all (no projectId field anywhere
// in either direction): reaching APPROVED only records that the business
// case was accepted, it is a distinct milestone, not a trigger. Turning an
// approved request into a real Project is an explicitly out-of-scope
// future feature.
model ProjectRequest {
  id String @id @default(cuid())

  title       String
  description String @db.Text
  // Reuses Project's OWN 1(Low)/2(Medium)/3(High) Int scale verbatim (see
  // lib/project-priority.ts's PROJECT_PRIORITY_LABEL/projectPriorityKey) —
  // the same semantic meaning, deliberately not a second/independent
  // importance mapping.
  importance  Int

  // HISTORICAL ONLY as of the Task Type move to Activity — the field/
  // relation name is deliberately left unchanged (a renamed historical
  // field adds nothing; see TaskType's own doc comment for why the model
  // itself moved). Nullable: a NEW ProjectRequest never sets this anymore
  // (removed from createProjectRequestSchema/the Project Request Form —
  // see project-request-service.ts), but every row submitted before this
  // change keeps its real, already-persisted value forever, untouched.
  projectType   TaskType? @relation(fields: [projectTypeId], references: [id])
  projectTypeId String?

  teamConcerned                     String
  expectedBenefits                  String  @db.Text
  // Legacy only — this was the requester-filled "Business Assessment" field
  // from the original form. The requester no longer fills ANY business
  // assessment; that moved entirely to the approver's decision (see
  // `businessAssessment` below, on the approval side of this model).
  // Nullable because every NEW request leaves it null forever; a non-null
  // value here means ONLY that this is a pre-redesign row — read-only,
  // rendered separately on the detail page, never conflated with the new
  // approver-side field of (confusingly) the same base name.
  legacyRequesterBusinessAssessment String? @db.Text
  replacesExisting                  Boolean @default(false)
  // Required (trimmed, non-empty) exactly when replacesExisting is true,
  // and ALWAYS null when it's false — enforced server-side in
  // createProjectRequestSchema (lib/validations.ts), never trusted from
  // client state alone. Nullable at the DB level purely because it's
  // conditionally absent (false case), not because it's ever optional
  // while replacesExisting is true.
  replacementDescription            String? @db.Text

  // Every field below this point is written ONLY by the server (see
  // lib/services/project-request-service.ts) — never accepted, trusted, or
  // echoed back from client input on submission or on any approval action.
  requester    User       @relation("ProjectRequestRequester", fields: [requesterId], references: [id])
  requesterId  String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String

  // New requests start awaiting unanimous intermediate approval (see
  // ProjectRequestIntermediateApprover) — only after every selected
  // intermediate approver has approved does this advance to
  // PENDING_APPROVAL, the pre-existing single final stage. Legacy rows
  // (created before this stage existed) were already at PENDING_APPROVAL/
  // APPROVED/REJECTED and are left exactly as they were — this default
  // only governs NEW rows, see this migration's own doc comment.
  status ProjectRequestStatus @default(PENDING_INTERMEDIATE_APPROVAL)

  // Every user the REQUESTER selected, at submission time, as an
  // intermediate approver for THIS request — a snapshot (see
  // ProjectRequestIntermediateApprover's own doc comment): later changes to
  // who holds projectRequest.intermediateApprove never add/remove anyone
  // from an already-submitted request's own list.
  intermediateApprovers ProjectRequestIntermediateApprover[]

  // Single FINAL approval stage — completely unchanged by the intermediate
  // stage's addition (same fields, same decideApproval, same
  // projectRequest.approve permission). Null until decided. Whoever holds
  // effective projectRequest.approve for `departmentId` (checked fresh at
  // decision time via hasEffectiveEntityPermission, never a snapshot) may
  // act — but ONLY once status has actually reached PENDING_APPROVAL, which
  // decideApproval's own status guard already enforces for free (a request
  // still at PENDING_INTERMEDIATE_APPROVAL simply isn't PENDING_APPROVAL
  // yet — no separate "is intermediate done" check needed anywhere).
  approver           User?     @relation("ProjectRequestApprover", fields: [approverId], references: [id])
  approverId         String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  // The FINAL approver's OWN mandatory justification — required at the
  // application level (projectRequestApprovalDecisionSchema) for every
  // approve/reject; nullable here only because a never-decided row has no
  // decision yet. Never touched by the intermediate stage — see each
  // ProjectRequestIntermediateApprover row's OWN businessAssessment for
  // that stage's own, separate audit trail. Formerly an optional decision
  // "comment" (pre-redesign); renamed in place via migration, preserving
  // any legacy comment text as-is. Never the requester's own text — see
  // legacyRequesterBusinessAssessment above for that.
  businessAssessment String?   @db.Text

  // The Project automatically created once this request's FINAL approval
  // completes (see decideApproval) — null for every request not yet
  // approved, and for every row that predates this feature. The FK lives
  // on Project (projectRequestId, @unique) since a Project originates from
  // at most one request, never the reverse.
  project Project?

  // The ONE feedback row the original requester (above) may submit once
  // this request's Project is completed — see ProjectFeedback's own doc
  // comment. Null until submitted; null forever for a request whose
  // Project was never completed, or that has no Project yet.
  feedback ProjectFeedback?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([requesterId])
  @@index([approverId])
  @@index([createdAt])
}

// One row per user the requester selected as an intermediate approver for a
// SPECIFIC ProjectRequest — a snapshot taken at submission time, never
// re-derived later. ALL rows for a given request must reach APPROVED
// (unanimous) before that request's own status advances past
// PENDING_INTERMEDIATE_APPROVAL; any ONE row reaching REJECTED immediately
// rejects the whole request (see decideIntermediateApproval). This is the
// complete, independent audit trail for the intermediate stage — who was
// asked, whether/when/why each one decided, and by whom — entirely separate
// from ProjectRequest's own approver/approvedAt/businessAssessment fields,
// which remain reserved for the FINAL stage only.
model ProjectRequestIntermediateApprover {
  id String @id @default(cuid())

  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  projectRequestId String

  approver   User   @relation("ProjectRequestIntermediateApprover", fields: [approverId], references: [id])
  approverId String

  status             IntermediateApprovalStatus @default(PENDING)
  decidedAt          DateTime?
  // This approver's OWN mandatory justification — required at the
  // application level for every approve/reject, mirroring the final
  // stage's own businessAssessment requirement; nullable here only because
  // a still-PENDING row has no decision yet.
  businessAssessment String?                    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One decision per (request, approver) pair — a user selected twice for
  // the same request (never possible via the UI's own dedup, but never
  // trusted from client input alone) can still only ever hold ONE row,
  // never a duplicate that could be decided twice.
  @@unique([projectRequestId, approverId])
  @@index([projectRequestId])
  @@index([approverId])
}

// Per-department, editable status->progress% mapping — Activity progress is
// derived from status (see lib/activities/activity-progress.ts), never
// manually entered, but each department may set its own percentages (e.g.
// IT might treat BLOCKED as 50%, another department as 25%). Full CRUD via
// /admin/activity-progress: a department may disable (isEnabled) or delete
// a status's row entirely — the resolver treats either as a configuration
// gap (logged, fail-safe), never a hardcoded per-status-name guess. Every
// department is backfilled with all 6 rows (see the migration and
// lib/services/config-starter-data.ts's ensureActivityProgressConfigForDepartment)
// so this is only ever reached in practice via a deliberate admin delete.
model ActivityProgressConfig {
  id              String         @id @default(cuid())
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId    String
  status          ActivityStatus
  progressPercent Int            @default(0)
  isEnabled       Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([departmentId, status])
  @@index([departmentId, isEnabled])
}

// Which ProjectStatus/ActivityStatus values count as "terminal" (done/
// closed, in the same sense TicketStatus.isClosed already captures for
// tickets) — per department, since a status name alone (e.g. "Cancelled")
// carries no terminal-ness signal on its own and no code should hardcode
// that assumption. Same shape/precedent as ActivityProgressConfig directly
// above: a department-scoped, status-keyed config row, admin-editable,
// with hardcoded defaults (COMPLETED/CANCELLED = terminal, everything else
// = not) as the fallback whenever no row exists yet — see
// lib/status-terminal.ts, the single place that reads these with that
// fallback baked in, and lib/overdue.ts, which is the only consumer that
// needs "is this terminal" at all. Not all 5/6 status values need a row
// per department up front (unlike ActivityProgressConfig's "always seed
// all 6"): an absent row just means "use the default", which is exactly
// today's implicit (hardcoded) behavior — so this migration changes
// nothing observable for any existing department until an admin opts in.
model ProjectStatusConfig {
  id           String        @id @default(cuid())
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  status       ProjectStatus
  isTerminal   Boolean
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([departmentId, status])
}

// Department-scoped display metadata AND terminal-ness for ActivityStatus —
// the SAME row/table the pre-existing isTerminal resolution
// (lib/status-terminal.ts) already reads, extended rather than duplicated
// (lib/services/activity-status-config.ts reads the new columns). The fixed
// ActivityStatus enum key (TODO, IN_PROGRESS, ...) never changes — only its
// department-specific label/color/sortOrder/isEnabled/isTerminal do, e.g.
// IT's TODO can display "To Do" while Sales' TODO displays "New Activity",
// independently, without ever touching the Prisma enum itself.
model ActivityStatusConfig {
  id           String         @id @default(cuid())
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  status       ActivityStatus
  // Backfilled from the previous app-wide hardcoded label
  // (components/gantt/status-colors.ts's STATUS_LABEL) for all pre-existing
  // rows — admin-editable per department afterward.
  label        String
  color        String         @default("#94a3b8")
  sortOrder    Int            @default(0)
  isEnabled    Boolean        @default(true)
  isTerminal   Boolean
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([departmentId, status])
  @@index([departmentId, isEnabled])
}

// Department-scoped enablement + display order for ActivityPriority values
// — the same "scoped configuration, admin-editable, full-backfilled row set"
// precedent as ActivityProgressConfig/ProjectStatusConfig/ActivityStatusConfig
// above, this time for priority. `sortOrder` is what "the configured order"
// (Project Gantt's Priority filter, Resource Planning's own priority list)
// actually reads — never a hardcoded URGENT>HIGH>MEDIUM>LOW constant.
// `isEnabled` controls whether a value is offered as a NEW selectable filter
// option; a record already carrying a disabled priority stays fully visible
// everywhere it's shown (see lib/priority-config.ts) — disabling only
// affects what's offered going forward, exactly like TicketPriority.isActive.
model ActivityPriorityConfig {
  id           String           @id @default(cuid())
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  priority     ActivityPriority
  sortOrder    Int
  isEnabled    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([departmentId, priority])
}

model ActivityDependency {
  id            String          @id @default(cuid())
  predecessorId String
  predecessor   ProjectActivity @relation("ActivityDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     ProjectActivity @relation("ActivityDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type          DependencyType  @default(FINISH_TO_START)
  createdById   String?
  createdBy     User?           @relation("ActivityDependenciesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([predecessorId, successorId, type])
  @@index([predecessorId])
  @@index([successorId])
}

// ─── Yearly Goals ─────────────────────────────────────────────────────────────

model YearlyGoal {
  id           String     @id @default(cuid())
  year         Int
  status       GoalStatus @default(NOT_STARTED)
  targetValue  Float?
  currentValue Float?
  unit         String?
  owner        User       @relation("GoalOwner", fields: [ownerUserId], references: [id])
  ownerUserId  String
  projects     Project[]  @relation("GoalProjects")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([year])
  @@index([ownerUserId])
}

// ─── Custom Roles ─────────────────────────────────────────────────────────────

// Which role system a CustomRole row represents. RolePermission.roleKey is a
// bare string shared by both the global Role enum and the DepartmentRole
// enum (see the RolePermission model below) — this field is what lets
// /admin/roles show two separate tabs from the same table, and lets the
// permission-grant route block department-scoped roles from ever getting
// system-administration permissions (admin.access/user.manage/role.manage).
// BOTH exists for DEPARTMENT_MANAGER specifically: it's one intentionally
// shared roleKey used by both Role.DEPARTMENT_MANAGER and
// DepartmentRole.DEPARTMENT_MANAGER (see prisma/seed.ts) — not two rows.
enum RoleScope {
  GLOBAL
  DEPARTMENT
  BOTH
}

model CustomRole {
  id                                String                       @id @default(cuid())
  key                               String                       @unique
  name                              String
  description                       String?
  isBuiltIn                         Boolean                      @default(false)
  // Disable lever for built-in roles (which can never be hard-deleted — see
  // lib/services/role-safety-service.ts) and custom roles alike. A disabled
  // role stops being offered for new assignment (getDepartmentRoleOptions)
  // and hasPermission/hasDepartmentPermission fall back to the caller's base
  // enum role when their customRoleId points at an inactive row — but an
  // enum-based built-in role (User.role/DepartmentMembership.role used
  // directly, no customRoleId) can't be retroactively revoked this way; see
  // the doc-comment on wouldOrphanAdminAccessByDisablingRole.
  isActive                          Boolean                      @default(true)
  scope                             RoleScope                    @default(GLOBAL)
  users                             User[]                       @relation("UserCustomRole")
  departmentMemberships             DepartmentMembership[]       @relation("DepartmentMembershipCustomRole")
  // Microsoft mappings that grant this role — see MicrosoftDepartmentMapping's
  // globalCustomRoleId/departmentCustomRoleId comments. Referenced by the
  // role-deletion guard (app/api/admin/roles/[id]/route.ts) so a role in use
  // by a mapping can never be silently orphaned by a hard delete.
  microsoftMappingsAsGlobalRole     MicrosoftDepartmentMapping[] @relation("MicrosoftMappingGlobalCustomRole")
  microsoftMappingsAsDepartmentRole MicrosoftDepartmentMapping[] @relation("MicrosoftMappingDepartmentCustomRole")
  // The configurable "Default Global Role" / "Default Department Role" —
  // see DefaultRoleConfig. A CustomRole currently configured as either
  // default can never be deleted or deactivated until the default is
  // changed/cleared first (app/api/admin/roles/[id]/route.ts).
  defaultRoleConfigsAsGlobal        DefaultRoleConfig[]          @relation("DefaultRoleConfigGlobal")
  defaultRoleConfigsAsDepartment    DefaultRoleConfig[]          @relation("DefaultRoleConfigDepartment")
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
}

// Singleton (fixed id "singleton", same idiom as OrganizationSyncLock) admin
// config: which CustomRole a newly-provisioned user/department-membership
// gets when nothing more specific (an explicit MicrosoftDepartmentMapping)
// applies. See lib/services/default-role-service.ts — the sole reader/writer
// of this table; every provisioning call site (Microsoft login sync,
// tenant-wide directory sync, inbound-email requester creation, the
// department-auto-create bootstrap mapping) resolves through it rather than
// hardcoding Role.USER/DepartmentRole.REQUESTER directly. Both fields
// reference CustomRole (never a bare Role/DepartmentRole enum value) so an
// admin can point either default at any active role, built-in or custom.
model DefaultRoleConfig {
  id String @id @default("singleton")

  // Must be an active CustomRole with scope GLOBAL or BOTH — enforced in
  // lib/services/default-role-service.ts, not just here (onDelete: SetNull
  // alone can't express "or deactivated").
  defaultGlobalCustomRole   CustomRole? @relation("DefaultRoleConfigGlobal", fields: [defaultGlobalCustomRoleId], references: [id], onDelete: SetNull)
  defaultGlobalCustomRoleId String?

  // Must be an active CustomRole with scope DEPARTMENT or BOTH.
  defaultDepartmentCustomRole   CustomRole? @relation("DefaultRoleConfigDepartment", fields: [defaultDepartmentCustomRoleId], references: [id], onDelete: SetNull)
  defaultDepartmentCustomRoleId String?

  updatedAt DateTime @updatedAt
}

// ─── Permissions ──────────────────────────────────────────────────────────────

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  module      String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleKey      String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@id([roleKey, permissionId])
  @@index([roleKey])
}

// ─── SLA ──────────────────────────────────────────────────────────────────────

model SlaSettings {
  id        String   @id @default(cuid())
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model SlaPolicy {
  id                 String         @id @default(cuid())
  priority           TicketPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  priorityId         String         @unique
  firstResponseHours Int            @default(8)
  resolutionHours    Int            @default(48)
  updatedAt          DateTime       @updatedAt
}

// ─── Mention Reminders ────────────────────────────────────────────────────────

enum MentionReminderStatus {
  PENDING
  PROCESSING
  RESPONDED
  SENT
  CANCELLED
}

// One durable reminder per structured Project/Activity Note mention
// (TicketMessageMention deliberately has NO reminder). Exactly one source is
// set (CHECK constraint in the migration); each source mention has at most
// one reminder (unique FKs). Cascades with the mention, hence with the Note
// and the Project/Activity. Claimed atomically by
// lib/services/mention-reminder-service.ts (FOR UPDATE SKIP LOCKED +
// claimToken); a PROCESSING row whose claimedAt is older than the stale
// timeout is reclaimable, so a crashed worker never strands a reminder.
model MentionReminder {
  id                    String                @id @default(cuid())
  projectNoteMention    ProjectNoteMention?   @relation(fields: [projectNoteMentionId], references: [id], onDelete: Cascade)
  projectNoteMentionId  String?               @unique
  activityNoteMention   ActivityNoteMention?  @relation(fields: [activityNoteMentionId], references: [id], onDelete: Cascade)
  activityNoteMentionId String?               @unique
  dueAt                 DateTime
  status                MentionReminderStatus @default(PENDING)
  sentAt                DateTime?
  respondedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  claimedAt             DateTime?
  claimToken            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([status, dueAt])
}

// Singleton (id = "default") admin-configured delay, stored as normalized
// minutes. Missing row => DEFAULT_MENTION_REMINDER_DELAY_MINUTES (24h).
model MentionReminderSettings {
  id           String   @id @default("default")
  delayMinutes Int      @default(1440)
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Email Processing ─────────────────────────────────────────────────────────

enum EmailLogAction {
  CREATED_TICKET
  APPENDED_REPLY
  SKIPPED_DUPLICATE
  SKIPPED_LOOP
  FAILED
}

model EmailProcessingLog {
  id        String         @id @default(cuid())
  runId     String
  messageId String?
  fromEmail String?
  subject   String?
  action    EmailLogAction
  ticketId  String?
  error     String?        @db.Text
  createdAt DateTime       @default(now())
  // Multi-mailbox inbound polling: which mailbox this message was actually
  // fetched from (normalized lowercase) — e.g. the central support mailbox
  // or a department's own Department.inboundEmail. Null only for pre-
  // migration rows and the small number of paths that don't fetch from a
  // specific Graph mailbox (never backfilled/guessed). See
  // lib/services/inbound-mailbox-service.ts / processInboundEmails in
  // lib/ticket-email-service.ts.
  mailbox   String?

  @@index([runId])
  @@index([createdAt])
  @@index([action])
  @@index([mailbox])
}

/**
 * Per-mailbox inbound-polling cursor — the receivedDateTime boundary up to
 * which processInboundEmails (lib/ticket-email-service.ts) has already
 * looked at every message in that mailbox's Inbox, regardless of its
 * Outlook read/unread state. Replaces the old isRead-based "what's new"
 * signal: this app no longer marks any inbound email read or moves it out
 * of the Inbox (see getMessagesSince, lib/microsoft-graph.ts), because some
 * users only have Outlook access to these shared mailboxes and must see
 * every email exactly as a normal, untouched Inbox. A mailbox with no row
 * here yet has never been polled — getMailboxPollCursor
 * (lib/services/inbound-mailbox-service.ts) defaults it to the Unix epoch,
 * never silently skipping a pre-existing backlog.
 */
model MailboxPollCursor {
  /** Normalized (trim + lowercase) mailbox address — same normalization inbound-mailbox-service.ts already applies to every mailbox it discovers. */
  mailbox        String   @id
  lastReceivedAt DateTime
  updatedAt      DateTime @updatedAt
}

model EmailPollRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  created        Int       @default(0)
  appended       Int       @default(0)
  skipped        Int       @default(0)
  errors         Int       @default(0)
  lastError      String?   @db.Text
  succeeded      Boolean   @default(false)
  // Per-mailbox breakdown for THIS run — one entry per mailbox actually
  // polled (central support mailbox + every active department's
  // inboundEmail), each shaped like MailboxPollResult in
  // lib/ticket-email-service.ts: { mailbox, kind, departmentId,
  // departmentName, ok, error, fetched, created, appended, skipped, errors }.
  // Null for runs before this column existed. Deliberately JSON, not a
  // separate relational table — this is a point-in-time diagnostic snapshot
  // for the admin Email Integration screen, never queried/joined against by
  // application logic (PendingTicket/Department routing reads Department.
  // inboundEmail directly, never this column).
  mailboxResults Json?

  @@index([startedAt])
}

// ─── Outbound Notification Log ────────────────────────────────────────────────

enum EmailNotificationType {
  REPLY
  CLOSED
  CREATED
}

enum EmailNotificationStatus {
  SENT
  FAILED
  SKIPPED
  // Claimed but not yet resolved — see eventKey below. A row is inserted
  // with this status FIRST (the insert itself is the atomic ownership
  // claim, via the unique constraint on eventKey), then updated to
  // SENT/FAILED/SKIPPED once the actual send attempt resolves.
  PENDING
}

model EmailNotificationLog {
  id             String                  @id @default(cuid())
  ticketId       String
  messageId      String?
  recipientEmail String
  type           EmailNotificationType
  status         EmailNotificationStatus
  error          String?                 @db.Text
  createdAt      DateTime                @default(now())
  // Database-backed idempotency for lifecycle events (CREATED/CLOSED) that
  // must fire at most once per real transition, safe under concurrent or
  // retried requests — a plain findFirst-before-create has a TOCTOU race
  // under concurrency, so this unique constraint is the actual guard: the
  // INSERT with a given eventKey either succeeds (this call now atomically
  // owns the event) or fails with P2002 (some other call already claimed
  // it), never both succeeding. Null for REPLY rows (unchanged, no
  // eventKey-based dedupe requested for that type — its own
  // messageId/direction check already prevents loops) — Postgres allows
  // unlimited NULLs under a unique index, so this is fully backward
  // compatible with existing REPLY log rows. Format: `ticket:{id}:created`
  // for the one-time creation event; `ticket:{id}:closed:{closedAt ISO}`
  // for a close transition, so a genuine reopen-then-reclose produces a new
  // key (new closedAt) and is allowed to send a new email, while a retry of
  // the SAME transition (same closedAt) collapses onto the same row.
  eventKey       String?                 @unique

  @@index([ticketId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}

// ─── Web Push Notification Log (requester lifecycle pushes) ───────────────────
//
// Same atomic-claim idempotency architecture as EmailNotificationLog above
// (see that model's eventKey doc comment for the full TOCTOU-race reasoning)
// — a sibling table, not a reuse of EmailNotificationLog, because push
// events target a userId (PushSubscription lookup), not a recipientEmail,
// and because REPLY push events need a real, always-present eventKey (email
// leaves REPLY's eventKey null; push does not — see PushNotificationType
// below). Deliberately NOT the PushSubscription model — that stores a
// browser's subscription keys; this stores "did we already attempt to
// notify the requester about THIS business event."
//
// eventKey format:
//   `ticket:{ticketId}:reply:{messageId}`      — one key per reply message,
//     ever; a retried/duplicate request for the same message collapses onto
//     the same row.
//   `ticket:{ticketId}:terminal:{closedAt ISO}` — scoped to the specific
//     close TRANSITION via the ticket's own persisted closedAt, exactly like
//     EmailNotificationLog's CLOSED key — a genuine reopen-then-reclose gets
//     a new closedAt and therefore a new key/new push, while a retry of the
//     same transition collapses onto the same row.
enum PushNotificationType {
  REPLY
  TERMINAL
}

enum PushNotificationStatus {
  SENT
  FAILED
  // No PushSubscription rows existed for the recipient at send time (or
  // VAPID isn't configured in this environment) — the event was still
  // legitimately claimed/logged, just nothing to deliver to.
  SKIPPED
  // Claimed but not yet resolved — see eventKey above; same PENDING-then-
  // resolved lifecycle as EmailNotificationStatus.PENDING.
  PENDING
}

model PushNotificationLog {
  id        String                 @id @default(cuid())
  ticketId  String
  messageId String?
  userId    String
  type      PushNotificationType
  status    PushNotificationStatus
  error     String?                @db.Text
  createdAt DateTime               @default(now())
  eventKey  String                 @unique

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}

// ─── One-time legacy migration (scripts/migrate-legacy-ticketapp.ts) ──────────

enum LegacyMigrationEntityType {
  USER
  TICKET
  COMMENT
  ATTACHMENT
}

enum LegacyMigrationStatus {
  SUCCEEDED
  FAILED
}

// Durable idempotency ledger for the one-time legacy TicketApp import — the
// SOLE mechanism the migration runner consults to decide "has this exact
// source record already been migrated." A second `--execute` run reads this
// table before creating anything for a given (source, entityType, legacyKey)
// triple; on a hit it reuses `targetId` instead of creating a duplicate.
// `legacyKey` is always the source system's own stable identifier as a
// string (legacy UserName, Tickets.Id, CommentsTbl.Id, FileDataTbl.Id) —
// never a derived/guessed value. A FAILED row records why a specific source
// record could not be migrated (see errorMessage) without blocking retry of
// everything else; rerunning after a fix reprocesses only rows that are
// still missing a SUCCEEDED entry.
model MigrationLedger {
  id           String                    @id @default(cuid())
  // Fixed to "TICKETAPP_V1" today — kept as a real column (not hardcoded
  // into the unique index) so a future, unrelated legacy source could reuse
  // this same table without colliding on legacyKey identity.
  source       String
  entityType   LegacyMigrationEntityType
  legacyKey    String
  // Null when status is FAILED and nothing was actually persisted.
  targetId     String?
  status       LegacyMigrationStatus
  // Optional content fingerprint (e.g. a hash of the fields that determine
  // whether a re-run's source data changed) — populated only where the
  // runner finds it useful; never required for idempotency itself, which is
  // keyed purely on (source, entityType, legacyKey) existing at all.
  checksum     String?
  errorMessage String?                   @db.Text
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([source, entityType, legacyKey])
  @@index([source, entityType, status])
}

// A saved external link (SharePoint doc, wiki page, etc.) attached to EXACTLY
// ONE Project or Activity. One shared model for both surfaces (see
// lib/services/related-links-service.ts) rather than two per-entity tables.
// The "exactly one owner" invariant (projectId XOR activityId) is enforced by
// a database CHECK constraint (RelatedLink_exactly_one_owner_chk, added in
// the migration — Prisma's schema language cannot express CHECK constraints),
// not just application code. URLs are deliberately NOT unique: the same URL
// may legitimately be referenced with different notes. The URL is only ever
// stored and rendered as a link — the server never fetches it.
model RelatedLink {
  id          String           @id @default(cuid())
  url         String           @db.VarChar(2048)
  title       String           @db.VarChar(250)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?
  activity    ProjectActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId  String?
  // Nullable + SetNull: a link outlives its creator's account being deleted.
  createdBy   User?            @relation("RelatedLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId, createdAt])
  @@index([activityId, createdAt])
  @@index([createdById])
}
