generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  IT_AGENT
  DEPARTMENT_MANAGER
  // Cross-department oversight: view (and create projects/activities) in
  // every department, without the admin.*/user.manage/role.manage/
  // department.manage* power Administrator has. See canViewAllDepartments()
  // in lib/permissions.ts and its use in workspace-service.ts /
  // department-scope-service.ts.
  DIRECTOR
  USER
}

enum TicketSource {
  WEB
  EMAIL
  // Created by a server-to-server call to POST /api/integrations/tickets,
  // authenticated via an ExternalIntegration API key — see that model below.
  API
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL_NOTE
}

enum TicketHistoryType {
  CREATED
  STATUS_CHANGE
  PRIORITY_CHANGE
  CATEGORY_CHANGE
  ASSIGNMENT_CHANGE
  DEPARTMENT_CHANGE
  CLOSED
  REOPENED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  CANCEL_REASON_SET
}

enum AuthProvider {
  MICROSOFT
  CREDENTIALS
}

// Standing within a single department — distinct from the global `Role` enum,
// which governs cross-cutting/system concerns (admin panel, credentials login).
// System Admin is represented by the global `Role.ADMIN` and bypasses these
// entirely rather than being a value here (see lib/permissions.ts).
enum DepartmentRole {
  DEPARTMENT_ADMIN
  DEPARTMENT_MANAGER
  PROJECT_MANAGER
  AGENT_ASSIGNEE
  REQUESTER
  VIEWER
}

// How a DepartmentMembership row was established. MANUAL rows are admin
// overrides and must never be modified by the Microsoft login-sync process.
enum MembershipSource {
  MICROSOFT_DEPARTMENT
  MICROSOFT_GROUP
  MICROSOFT_APP_ROLE
  MICROSOFT_JOB_TITLE
  MANUAL
}

// How User.role (the GLOBAL role, distinct from DepartmentRole) was last
// set — mirrors MembershipSource's protection model so the same "never
// overwrite a manual decision" rule applies to the global role too. SYSTEM
// (not MANUAL) is the default so fresh/seeded users stay eligible for
// Microsoft sync until an admin actually makes an explicit choice.
enum GlobalRoleSource {
  SYSTEM
  MANUAL
  MICROSOFT_DEPARTMENT
}

// Provenance of User.image — same "never overwrite a manual decision"
// protection model as MembershipSource/GlobalRoleSource above. MANUAL means
// an admin or the user themself explicitly set the image (no such write path
// exists yet in the app, but this flag is what any future upload feature
// MUST set — see lib/services/microsoft-profile-photo-service.ts). Null
// means "never explicitly tracked" (legacy rows from before this field
// existed) — the sync service treats null the same as MICROSOFT for update
// eligibility, since historically the only code path that ever wrote
// User.image was the Microsoft sign-in flow.
enum AvatarSource {
  MICROSOFT
  MANUAL
}

// Which kind of Microsoft/Entra signal a MicrosoftDepartmentMapping row
// matches against.
enum MicrosoftMappingSourceType {
  PROFILE_DEPARTMENT
  PROFILE_JOB_TITLE
  ENTRA_GROUP
  ENTRA_APP_ROLE
}

// RUNNING = no `completedAt` yet. SUCCEEDED = completed, errorCount stayed 0.
// PARTIAL = completed, some per-user records were skipped/errored but the run
// itself finished (see OrganizationSyncRun.errorCount) — never a hard
// all-or-nothing failure for one bad record. FAILED = the run itself aborted
// (e.g. lost the Graph token mid-run, permission revoked).
enum OrganizationSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

// FULL = paginated tenant-wide user directory scan + manager/directReports
// traversal. INCREMENTAL = user property refresh only (no manager traversal)
// — cheaper, safe to run more often. RELATIONSHIP_REFRESH = manager/
// directReports traversal only, skips the directory property scan — for
// periodically refreshing reporting lines without re-scanning every profile
// field.
enum OrganizationSyncType {
  FULL
  INCREMENTAL
  RELATIONSHIP_REFRESH
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  COMPLETED
  CANCELLED
}

// ─── Organisation Structure ───────────────────────────────────────────────────

model Company {
  id            String         @id @default(cuid())
  name          String
  // Trim + collapse-whitespace + lowercase of `name` (see
  // lib/services/organization-normalization.ts's normalizeCompanyName) — the
  // real duplicate-prevention backstop for "one Company root per
  // normalized Microsoft companyName" (Microsoft Directory Sync,
  // lib/services/organization-directory-sync-service.ts), the same
  // database-level-constraint-as-hard-backstop pattern already used for
  // User.email (see the add_user_email_case_insensitive_unique migration) —
  // application-level normalization alone is a convention, not a guarantee.
  normalizedName String        @unique
  // Optional: a Microsoft-sourced company (matched/created purely from
  // Entra's free-text companyName) has no inherent domain — only a manually
  // admin-created company (via /admin/companies) is expected to always set
  // one. Still unique when present.
  domain        String?        @unique
  businessUnits BusinessUnit[]
  // Departments attached directly to this Company (no BusinessUnit) — the
  // path Microsoft Directory Sync always uses, since Entra has no "business
  // unit" concept of its own. A manually admin-organized department instead
  // goes through `businessUnit` above, unchanged. See
  // lib/services/organization-directory-sync-service.ts and
  // lib/services/organization-tree-service.ts (which renders both paths
  // under the same Company node).
  directDepartments Department[] @relation("DepartmentDirectCompany")
  users         User[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BusinessUnit {
  id          String            @id @default(cuid())
  name        String
  company     Company           @relation(fields: [companyId], references: [id])
  companyId   String
  departments Department[]
  users       User[]
  projects    Project[]
  activities  ProjectActivity[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Department {
  id                      String                       @id @default(cuid())
  name                    String
  // Trim + collapse-whitespace + lowercase of `name` (see
  // lib/services/organization-normalization.ts's normalizeDepartmentName) —
  // paired with `companyId` below in a uniqueness backstop so Microsoft
  // Directory Sync can never create two "IT" departments under the same
  // Company. Nullable for backward compatibility with departments that
  // predate this column (backfilled for existing rows in the migration that
  // introduced it) — always populated going forward (createDepartment/
  // updateDepartment keep it in sync with `name`).
  normalizedName          String?
  slug                    String                       @unique
  description             String?
  isActive                Boolean                      @default(true)
  // Inbound mail routing address for the Pending Tickets flow — see
  // PendingTicket below. Normalized lowercase/trim before save (see
  // setDepartmentInboundEmail in lib/services/department-service.ts).
  // Null = not configured; unique across departments so one address can never
  // be claimed by two departments at once.
  inboundEmail            String?                      @unique
  businessUnit            BusinessUnit?                @relation(fields: [businessUnitId], references: [id])
  businessUnitId          String?
  // Direct Company placement — used ONLY when there's no meaningful
  // BusinessUnit to nest under (always true for a Microsoft-sourced
  // department, since Entra has no "business unit" concept). Mutually
  // exclusive with `businessUnitId` in practice (never both set), though the
  // schema doesn't hard-enforce that — see organization-tree-service.ts for
  // how the two paths are rendered under the same Company node either way.
  company                 Company?                     @relation("DepartmentDirectCompany", fields: [companyId], references: [id])
  companyId               String?
  subDepartments          SubDepartment[]
  users                   User[]
  memberships             DepartmentMembership[]
  microsoftMappings       MicrosoftDepartmentMapping[]
  tickets                 Ticket[]
  pendingTickets          PendingTicket[]
  projects                Project[]
  activities              ProjectActivity[]
  categories              TicketCategory[]
  priorities              TicketPriority[]
  statuses                TicketStatus[]
  cancelReasons           TicketCancelReason[]
  activityProgressConfigs ActivityProgressConfig[]
  projectStatusConfigs    ProjectStatusConfig[]
  activityStatusConfigs   ActivityStatusConfig[]
  activityPriorityConfigs ActivityPriorityConfig[]
  externalIntegrations    ExternalIntegration[]        @relation("IntegrationDepartment")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  // Guards the direct-Company placement path only (companyId set,
  // businessUnitId null — always true for Microsoft Directory Sync). A
  // NULL companyId never collides with another NULL (standard SQL unique-index
  // semantics), so this has zero effect on departments organized via
  // businessUnitId instead.
  @@unique([companyId, normalizedName])
}

// Per-user, per-department standing. Decoupled from User.departmentId (which
// remains the legacy "home department" FK, unchanged) — a user may hold
// memberships in multiple departments; at most one is flagged isPrimary.
model DepartmentMembership {
  id           String           @id @default(cuid())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  role         DepartmentRole
  // Custom department-scoped role (CustomRole.scope DEPARTMENT/BOTH) — when
  // set, this is the source of truth for permission checks (mirrors
  // User.customRoleId exactly) and `role` above just holds a required,
  // unused placeholder (VIEWER). See getEffectiveDepartmentRoleKey in
  // lib/permissions.ts.
  customRole   CustomRole?      @relation("DepartmentMembershipCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)
  customRoleId String?
  source       MembershipSource
  isPrimary    Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
  @@index([customRoleId])
}

// Pure data table: maps a Microsoft/Entra signal (profile department string,
// group name/id, or app role value) to an internal department + role, so the
// login-sync logic never hardcodes a department name in code.
// DOMAIN SCOPE (FIND-006, docs/roadmap-handoff-register.md): canonical
// mapping identity is `(sourceType, domain, normalizedMicrosoftValue)` —
// NOT `(sourceType, microsoftValue)` alone (the pre-FIND-006 constraint,
// dropped by migration 20260807170000_mapping_domain_scoped_identity).
//
// Only PROFILE_JOB_TITLE is REALLY domain-aware today: `domain` holds the
// Entra domain (e.g. "kinsen.gr") the mapping applies to, required and
// validated against organization-directory-eligibility-service.ts's
// allowed-domain set whenever this sourceType is created/updated
// (microsoft-mapping-service.ts). This lets the SAME raw job title (e.g.
// "Director") have independent mappings per domain once a second domain is
// ever enabled — `kinsen.gr` is the only one enabled today
// (ALLOWED_EMAIL_DOMAIN) — with zero further schema change needed then.
//
// Every OTHER sourceType (PROFILE_DEPARTMENT, ENTRA_GROUP, ENTRA_APP_ROLE)
// deliberately stays GLOBAL — `domain` is always the empty-string sentinel
// `""` for these, never a real domain, and neither the admin UI nor
// createMapping/updateMapping ever let one be set. Reasoning per source
// type (see docs/roadmap-handoff-register.md FIND-006 for the full
// write-up):
//   - ENTRA_GROUP / ENTRA_APP_ROLE: a group id or app role value is a
//     tenant-wide Entra construct, never derived from a user's own
//     domain/email at all (buildCandidates in microsoft-mapping-service.ts
//     never looks at email for these) — "domain-scoping" them would be
//     meaningless, not just unnecessary.
//   - PROFILE_DEPARTMENT: also a per-user profile string like job title,
//     but organizational PLACEMENT (which department/company a user
//     belongs to) is already handled by an entirely separate, actually
//     domain-aware mechanism — organization-company-department-resolver.ts
//     — for the PRIMARY department. This mapping type exists only for
//     SECONDARY membership/global-role granting, has no reported
//     multi-domain requirement, and changing its matching semantics now
//     was explicitly out of scope. `domain`/`normalizedMicrosoftValue` still
//     exist on every row for a uniform storage/query shape — enabling it
//     later needs no further schema change, only a code change mirroring
//     what PROFILE_JOB_TITLE already does.
//
// `""` (empty string), not SQL NULL, is deliberately the "no domain / global"
// sentinel — same convention as MicrosoftDirectoryJobTitleValue.domain
// (see that model's comment). NULL would make the compound unique index
// silently stop preventing duplicate global mappings (Postgres treats every
// NULL as distinct from every other NULL in a unique index), which would be
// a real regression for ENTRA_GROUP/ENTRA_APP_ROLE/PROFILE_DEPARTMENT's
// existing "one mapping per raw value" guarantee.
//
// `normalizedMicrosoftValue` mirrors the discovery catalog's approach
// (MicrosoftDirectoryJobTitleValue.normalizedValue) so matching is
// deterministic and identical across BOTH tables — never two different
// normalization rules for the same feature:
//   - PROFILE_JOB_TITLE: normalizeJobTitleValue(microsoftValue) — trim +
//     collapse-whitespace + lowercase (microsoft-directory-service.ts),
//     the exact function the discovery catalog already uses. This also
//     means creating both "Director" and "director" as two separate
//     PROFILE_JOB_TITLE mappings for the same domain is now a real,
//     enforced duplicate (rejected at the DB level) — previously only
//     prevented informally by a query-time case-insensitive match, not a
//     stored/enforced identity.
//   - every other sourceType: an EXACT copy of `microsoftValue`, untouched
//     — preserves today's exact-match semantics byte-for-byte; this column
//     exists there purely so one uniform compound index/query shape covers
//     every sourceType, not because those values are normalized in any way.
// `microsoftValue` itself remains the raw, admin-entered display value —
// never the lookup key on its own anymore.
model MicrosoftDepartmentMapping {
  id             String                     @id @default(cuid())
  sourceType     MicrosoftMappingSourceType
  microsoftValue String
  /** "" (global, every non-PROFILE_JOB_TITLE row) or a real Entra domain (PROFILE_JOB_TITLE only) — see this model's header comment. */
  domain         String                     @default("")
  /** Deterministic match key — see this model's header comment for the per-sourceType computation rule. */
  normalizedMicrosoftValue String            @default("")
  department     Department                 @relation(fields: [departmentId], references: [id])
  departmentId   String
  // The GLOBAL role (matches /admin/roles / User.role) — so this dropdown
  // shows exactly the same roles as Roles & Permissions.
  role           Role                       @default(USER)
  // The DepartmentRole granted in `department` above. Explicitly chosen by
  // the admin (no longer derived from `role` at sync time) — see
  // resolveDepartmentMemberships in lib/services/microsoft-mapping-service.ts.
  // DEPARTMENT_ADMIN is deliberately never allowed here (department-scoped
  // analog of Role.ADMIN) — see isDepartmentRoleAllowedForMicrosoftMapping in
  // lib/services/department-role-translation.ts.
  departmentRole DepartmentRole
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  usersWithGlobalRoleFromThisMapping User[] @relation("UserGlobalRoleMapping")

  @@unique([sourceType, domain, normalizedMicrosoftValue])
  @@index([departmentId])
  @@index([domain])
}

// Local cache of distinct `department` profile values seen across the
// Microsoft/Entra directory, discovered via an admin-triggered sync (never
// on page render/login) — backs the Microsoft Value dropdown on
// MicrosoftDepartmentMapping so admins select an exact value instead of
// hand-typing it. Rows are never deleted, only marked inactive if a later
// sync no longer sees them, so history isn't lost.
model MicrosoftDirectoryDepartmentValue {
  id          String   @id @default(cuid())
  value       String   @unique
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Started as the same shape/purpose as MicrosoftDirectoryDepartmentValue
// (a distinct `jobTitle` profile value cache backing the Microsoft Value
// dropdown when a MicrosoftDepartmentMapping's sourceType is
// PROFILE_JOB_TITLE — still true, unchanged), then extended for domain-aware
// Job Title auto-discovery (lib/services/microsoft-job-title-directory-service.ts).
//
// CANONICAL IDENTITY is `(domain, normalizedValue)` — enforced by the
// compound unique index below — NOT `value`. `value` is display/source data
// only (the first-seen raw casing/spacing) and is deliberately NOT globally
// unique: the exact same raw text (e.g. "IT Manager") must be able to exist
// once per domain once multiple domains are enabled (kinsen.gr today only,
// via ALLOWED_EMAIL_DOMAIN — see organization-directory-eligibility-service.ts).
// A prior revision of this migration kept a leftover global `@unique` on
// `value` (inherited by copy-paste from MicrosoftDirectoryDepartmentValue,
// which never got this domain extension) — that was a real bug blocking
// exactly this multi-domain scenario, closed by
// 20260807153000_job_title_value_domain_scoped_identity, which drops that
// index without touching any row's data/id.
//   - `domain` + `normalizedValue` + `userCount` are owned by the
//     domain-explicit discovery sync
//     (microsoft-job-title-directory-service.ts's syncMicrosoftJobTitleDirectory
//     and microsoft-directory-service.ts's Operation A/B), which both
//     upsert/lookup exclusively by the compound (domain, normalizedValue)
//     key — ready for a future multi-domain tenant without a further schema
//     change, since each domain gets its own row even when the raw text
//     collides. normalizedValue = trim + collapse-internal-whitespace +
//     lowercase; `value` keeps the first-seen human-readable casing for
//     display only, never used as a lookup/identity key anywhere in the
//     codebase (confirmed by audit — grep for `where: { value` against this
//     model turns up only this file's own header comment and read-only test
//     assertions, both value-non-unique-safe).
// Rows are never deleted, only marked inactive if a later sync no longer
// sees them, so history isn't lost.
model MicrosoftDirectoryJobTitleValue {
  id             String   @id @default(cuid())
  /** Display-only — first-seen raw casing/spacing. NOT unique (see this model's header comment) — (domain, normalizedValue) below is the real identity. */
  value          String
  /** Backfilled to the then-current ALLOWED_EMAIL_DOMAIN for every pre-existing row at migration time (see 20260807110000_job_title_directory_domain_scope) — never left blank, since it's part of a unique key. */
  domain         String   @default("")
  /** trim + collapse-whitespace + lowercase of `value`; also backfilled at migration time for pre-existing rows. */
  normalizedValue String  @default("")
  /** Eligible (@<domain>, userType=Member) users seen with this exact job title as of the last domain-aware sync — 0 for legacy rows never touched by it. */
  userCount      Int      @default(0)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([domain, normalizedValue])
  @@index([domain])
}

model SubDepartment {
  id           String                    @id @default(cuid())
  name         String
  slug         String?
  description  String?
  isActive     Boolean                   @default(true)
  department   Department                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  // Legacy single-FK relation — kept unchanged (see User.subDepartmentId).
  // SubDepartmentMembership below is the source of truth going forward,
  // mirroring how Department/DepartmentMembership already coexist.
  users        User[]
  memberships  SubDepartmentMembership[]
  tickets      Ticket[]
  projects     Project[]
  activities   ProjectActivity[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
}

// Per-user, per-sub-department standing — mirrors DepartmentMembership's
// shape (source tracking, soft revoke) but deliberately has no role: a
// SubDepartment is an organizational grouping for filtering, not a second
// permission tier. departmentId is denormalized from subDepartment.departmentId
// (validated on write in lib/services/sub-department-membership-service.ts)
// purely for fast filtering, same rationale as other denormalized FKs in
// this schema.
model SubDepartmentMembership {
  id              String           @id @default(cuid())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  subDepartment   SubDepartment    @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  subDepartmentId String
  departmentId    String
  source          MembershipSource
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, subDepartmentId])
  @@index([subDepartmentId])
  @@index([userId])
  @@index([departmentId])
}

// One row per organization-sync attempt (full tenant scan, incremental
// property refresh, or a manager/directReports-only relationship refresh).
// Mirrors EmailPollRun's shape (prisma/schema.prisma, EmailPollRun) but adds
// what that model lacks: an explicit status enum (EmailPollRun only has
// finishedAt/succeeded) — needed here because a run can legitimately finish
// PARTIAL (some bad records skipped) rather than a flat succeeded/failed.
model OrganizationSyncRun {
  id            String                 @id @default(cuid())
  type          OrganizationSyncType
  status        OrganizationSyncStatus @default(RUNNING)
  startedAt     DateTime               @default(now())
  completedAt   DateTime?
  usersScanned  Int                    @default(0)
  usersUpdated  Int                    @default(0)
  usersSkipped  Int                    @default(0)
  errorCount    Int                    @default(0)
  // Sanitized only — never a raw stack trace, never a token/secret value.
  lastError     String?                @db.Text
  deltaLink     String?                @db.Text
  // Admin User.id for a manual "Sync organization" click; null for any
  // future scheduled/automated trigger.
  triggeredById String?

  @@index([startedAt])
  @@index([status])
}

// Singleton row (always id="singleton") used as an atomic compare-and-set
// mutual-exclusion lock so two organization syncs can never run
// concurrently — see acquireOrganizationSyncLock in
// lib/services/organization-sync-orchestrator.ts. There is no locking
// precedent elsewhere in this schema (EmailPollRun has none) so this is
// deliberately its own minimal table rather than overloading another model.
model OrganizationSyncLock {
  id       String    @id @default("singleton")
  isLocked Boolean   @default(false)
  lockedAt DateTime?
  runId    String?
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id                           String                      @id @default(cuid())
  email                        String                      @unique
  emailVerified                DateTime?
  name                         String?
  // Entra `givenName`/`surname` — distinct from `name` (the combined display
  // name, Entra's `displayName`). Optional: only ever populated from
  // Microsoft directory sync (lib/services/organization-directory-sync-service.ts);
  // never required for a credentials-created account.
  givenName                    String?
  surname                      String?
  image                        String?
  // Provenance of `image` — see AvatarSource. Protects a manually-uploaded
  // avatar from ever being silently overwritten by Microsoft sync.
  avatarSource                 AvatarSource?
  // Graph photo ETag from the last successful sync — lets
  // syncMicrosoftProfilePhoto() send If-None-Match and skip a redundant
  // re-download/re-write when the Microsoft photo hasn't actually changed.
  microsoftPhotoEtag           String?
  // When `image` was last written by Microsoft sync — used as an optimistic
  // concurrency guard so a slower/older sync request can never clobber a
  // newer one (see the WHERE microsoftPhotoUpdatedAt < $fetchedAt guard in
  // lib/services/microsoft-profile-photo-service.ts). Distinct from
  // lastMicrosoftSyncAt below, which tracks the unrelated department sync.
  microsoftPhotoUpdatedAt      DateTime?
  role                         Role                        @default(USER)
  isActive                     Boolean                     @default(true)
  passwordHash                 String?
  authProvider                 AuthProvider                @default(MICROSOFT)
  mustChangePassword           Boolean                     @default(false)
  // Entra ID `oid` claim — stable identity anchor independent of email, so a
  // user's Microsoft identity survives an email change (see admin email edit).
  microsoftUserId              String?                     @unique
  // Set only on a *successful* Graph-based department sync during Microsoft
  // login (lib/services/microsoft-department-sync-service.ts) — never on a
  // failed fetch, so it always reflects the last time data actually synced.
  lastMicrosoftSyncAt          DateTime?
  // Tracks provenance of the GLOBAL `role` field above, mirroring
  // DepartmentMembership.source's protection model — see GlobalRoleSource.
  globalRoleSource             GlobalRoleSource            @default(SYSTEM)
  globalRoleUpdatedAt          DateTime?
  globalRoleMicrosoftMapping   MicrosoftDepartmentMapping? @relation("UserGlobalRoleMapping", fields: [globalRoleMicrosoftMappingId], references: [id], onDelete: SetNull)
  globalRoleMicrosoftMappingId String?
  company                      Company?                    @relation(fields: [companyId], references: [id])
  companyId                    String?
  businessUnit                 BusinessUnit?               @relation(fields: [businessUnitId], references: [id])
  businessUnitId               String?
  department                   Department?                 @relation(fields: [departmentId], references: [id])
  departmentId                 String?
  subDepartment                SubDepartment?              @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId              String?

  // People/reporting-line hierarchy — deliberately separate from the
  // Department/SubDepartment (organizational-unit) hierarchy above; the two
  // are not guaranteed to align (see docs on the organization-sync feature).
  // Sourced exclusively from Microsoft Graph's manager/directReports
  // navigation properties (lib/services/organization-manager-sync-service.ts)
  // — there is no admin-editable manual override, since Entra is the sole
  // authoritative source for reporting lines per the feature's design.
  manager                      User?                       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerId                    String?
  directReports                User[]                      @relation("UserManager")
  // True when the most recent manager sync (organization-manager-sync-service.ts,
  // directReports inversion) found this user AS a direct report of some
  // manager in Entra, but that manager was itself excluded from the synced
  // set (guest/service account, invalid record) — so `managerId` above is
  // null NOT because this user has no manager, but because their real
  // manager isn't a usable local row. Distinct from a genuine root (no
  // manager relationship exists in Entra at all) — see
  // lib/services/organization-unmapped-report-service.ts's
  // MANAGER_NOT_SYNCED classification, which reads this flag directly
  // rather than re-deriving it (the signal only exists transiently during a
  // sync run's Graph responses, so it must be persisted here to be
  // reportable afterward without another Graph call).
  managerExcludedFromSync      Boolean                     @default(false)
  // Entra `employeeId`/`employeeType` — diagnostic/organization-context
  // fields only; not used by any RBAC/department-mapping decision today.
  employeeId                   String?
  employeeType                 String?
  // Entra `accountEnabled`/`userType` at last sync — distinct from this
  // app's own `isActive` (a TicketApp-local decision, never overwritten by
  // sync). Used only to flag/report a mismatch (e.g. an Entra-disabled
  // account that's still `isActive` locally), never to auto-disable a user.
  entraAccountEnabled          Boolean?
  entraUserType                String?
  // Entra `jobTitle` at last sync — was previously only ever transient
  // (read from Graph at login, used for mapping resolution, then discarded).
  // Stored now so the organization-context API/visualization can display it
  // without an extra Graph call.
  jobTitle                     String?
  // Set on every successful organization-sync write for this user (full
  // tenant scan, incremental refresh, or the per-user login-time manager
  // lookup) — distinct from `lastMicrosoftSyncAt` above, which tracks the
  // unrelated department/global-role sync.
  organizationSyncedAt         DateTime?

  customRole   CustomRole? @relation("UserCustomRole", fields: [customRoleId], references: [id])
  customRoleId String?

  departmentMemberships    DepartmentMembership[]
  subDepartmentMemberships SubDepartmentMembership[]

  requestedTickets         Ticket[]              @relation("TicketRequester")
  assignedTickets          Ticket[]              @relation("TicketAgent")
  departmentChangedTickets Ticket[]              @relation("TicketDepartmentChangedBy")
  ticketMessages           TicketMessage[]
  ticketAttachments        TicketAttachment[]
  ticketHistories          TicketHistory[]
  pendingTicketsRequested  PendingTicket[]       @relation("PendingTicketRequester")
  pendingTicketsAccepted   PendingTicket[]       @relation("PendingTicketAccepted")
  createdIntegrations      ExternalIntegration[] @relation("IntegrationCreatedBy")
  pendingTicketsRejected   PendingTicket[]       @relation("PendingTicketRejected")
  ownedProjects            Project[]             @relation("ProjectOwner")
  projectMemberships       Project[]             @relation("ProjectMembers")
  assignedActivities       ProjectActivity[]     @relation("ActivityAssignee")
  activityAssignments      ProjectActivity[]     @relation("ActivityAssignees")
  createdActivities        ProjectActivity[]     @relation("ActivityCreator")
  createdDependencies      ActivityDependency[]  @relation("ActivityDependenciesCreatedBy")
  ownedGoals               YearlyGoal[]          @relation("GoalOwner")
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  accounts                 Account[]
  sessions                 Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Ticket Config Tables ─────────────────────────────────────────────────────

model TicketCategory {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  color               String                @default("#6366f1")
  isActive            Boolean               @default(true)
  // Always owned by exactly one department — there is no more global/shared
  // category. See the 20260727_retire_global_config migration and
  // scripts/retire-global-config.ts for the one-time data migration that
  // moved every pre-existing global row into a department before this
  // column became required.
  department          Department            @relation(fields: [departmentId], references: [id])
  departmentId        String
  tickets             Ticket[]
  integrationDefaults ExternalIntegration[] @relation("IntegrationDefaultCategory")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([departmentId, name])
}

model TicketPriority {
  id                  String                @id @default(cuid())
  name                String
  level               Int
  color               String
  isActive            Boolean               @default(true)
  // Always owned by exactly one department — there is no more global/shared
  // priority. Mirrors TicketCategory's departmentId. A department-owned
  // priority's SlaPolicy (below) is therefore department-scoped too, with
  // no extra field needed.
  department          Department            @relation(fields: [departmentId], references: [id])
  departmentId        String
  tickets             Ticket[]
  slaPolicy           SlaPolicy?
  integrationDefaults ExternalIntegration[] @relation("IntegrationDefaultPriority")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([departmentId, name])
}

model TicketStatus {
  id           String     @id @default(cuid())
  name         String
  color        String
  // isDefault/isClosed remain simple booleans, per-department: each
  // department marks its own default status. See resolveDefaultStatusId in
  // lib/services/department-scope-service.ts.
  isDefault    Boolean    @default(false)
  isClosed     Boolean    @default(false)
  isActive     Boolean    @default(true)
  order        Int        @default(0)
  // Always owned by exactly one department — there is no more global/shared
  // status. Mirrors TicketCategory.
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  tickets      Ticket[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, name])
}

model TicketCancelReason {
  id           String      @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean     @default(true)
  // Nullable = global/shared reason visible to every department (existing
  // rows); non-null = owned by one department. Mirrors TicketCategory.
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  tickets      Ticket[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([departmentId, name])
}

// ─── Tickets ──────────────────────────────────────────────────────────────────

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber Int          @unique @default(autoincrement())
  title        String
  description  String       @db.Text
  source       TicketSource @default(WEB)

  requester       User                @relation("TicketRequester", fields: [requesterId], references: [id])
  requesterId     String
  assignedAgent   User?               @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  assignedAgentId String?
  department      Department?         @relation(fields: [departmentId], references: [id])
  departmentId    String?
  // Must belong to the same departmentId as this ticket — validated in
  // lib/services/sub-department-service.ts, not enforced at the DB level.
  subDepartment   SubDepartment?      @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId String?
  category        TicketCategory?     @relation(fields: [categoryId], references: [id])
  categoryId      String?
  priority        TicketPriority?     @relation(fields: [priorityId], references: [id])
  priorityId      String?
  status          TicketStatus        @relation(fields: [statusId], references: [id])
  statusId        String
  cancelReason    TicketCancelReason? @relation(fields: [cancelReasonId], references: [id])
  cancelReasonId  String?

  emailMessageId String? @unique
  emailThreadId  String?

  project    Project?         @relation(fields: [projectId], references: [id])
  projectId  String?
  activity   ProjectActivity? @relation(fields: [activityId], references: [id])
  activityId String?

  // Ticket-only sharing (never Project/Activity): a non-full-view department
  // member (see splitTicketViewScope in department-scope-service.ts) only
  // sees their own tickets by default — these flags opt a specific ticket
  // into being visible to every active member of its Department/
  // SubDepartment too. Enforced centrally in buildTicketListWhere/
  // canViewTicket, never as a page-local filter.
  shareWithDepartment    Boolean @default(false)
  shareWithSubDepartment Boolean @default(false)

  // Who last moved this ticket's Department/SubDepartment, and when — set
  // only by PATCH /api/tickets/[id]/department. Denormalized alongside the
  // full audit trail in TicketHistory (type: DEPARTMENT_CHANGE) so All
  // Tickets can show "changed by" without a per-ticket history lookup.
  departmentChangedBy   User?     @relation("TicketDepartmentChangedBy", fields: [departmentChangedById], references: [id], onDelete: SetNull)
  departmentChangedById String?
  departmentChangedAt   DateTime?

  messages    TicketMessage[]
  attachments TicketAttachment[]
  history     TicketHistory[]

  // Set only when this ticket originated from an accepted PendingTicket —
  // see acceptPendingTicket in lib/services/pending-ticket-service.ts. Never
  // set for WEB-created or directly-appended-reply tickets.
  pendingTicketOrigin PendingTicket?

  // Set only for source: API tickets — see POST /api/integrations/tickets
  // and lib/services/ticket-creation-service.ts. onDelete: Restrict
  // (explicit override of the implicit SetNull an optional relation would
  // otherwise get) is deliberate: an ExternalIntegration with tickets
  // attached to it can never be hard-deleted out from under them, so a
  // ticket's "which application created this" provenance can never be
  // silently lost — see the ExternalIntegration model's own doc comment.
  // Disabling (isActive: false) is the supported way to retire an
  // integration; deletion is intentionally not exposed by any admin route.
  integration         ExternalIntegration? @relation("IntegrationTickets", fields: [integrationId], references: [id], onDelete: Restrict)
  integrationId       String?
  // The calling application's own idempotency key for the business event
  // that created this ticket — always set together with integrationId,
  // never independently. See the @@unique constraint below, which is the
  // actual duplicate-ticket guard (not an application-level check alone).
  externalReferenceId String?
  // Deep link back to the exact screen/record in the source application —
  // validated against ExternalIntegration.baseUrl's origin at creation time
  // (see the endpoint), but stored as-is (full URL) since baseUrl itself is
  // optional and a ticket must still remember its own link either way.
  sourceUrl           String?
  // Arbitrary caller-supplied structured context (e.g. { vehicleId, plate,
  // environment }) — opaque to TicketApp beyond a server-side size cap
  // enforced at write time (see the endpoint's validation); rendered as a
  // compact key/value list in the UI, never dumped as raw HTML.
  externalMetadata    Json?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([integrationId, externalReferenceId])
  @@index([requesterId])
  @@index([assignedAgentId])
  @@index([statusId])
  @@index([priorityId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@index([createdAt])
  @@index([projectId])
  @@index([activityId])
  @@index([shareWithDepartment])
  @@index([shareWithSubDepartment])
  @@index([departmentChangedById])
  @@index([integrationId])
}

// ─── External Integrations ─────────────────────────────────────────────────────
//
// One row per external application allowed to create real Tickets directly
// via POST /api/integrations/tickets (server-to-server, API-key
// authenticated — never a browser session/NextAuth cookie). Deliberately
// NOT a User/session-based principal: an integration is a scoped credential,
// not a person, so it never appears as a Ticket.requesterId — the real
// human who hit the problem is resolved separately per-request from the
// request body's requesterEmail (see resolveOrCreateRequester in
// lib/services/requester-resolution-service.ts).
//
// Every integration is pinned to exactly one Department at creation time —
// the incoming request can never choose or override this (see the
// endpoint's Zod schema, which doesn't even accept a departmentId field) —
// so a leaked/misused key's blast radius is a single department's ticket
// queue, never "any department in the system."
model ExternalIntegration {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  department   Department @relation("IntegrationDepartment", fields: [departmentId], references: [id])
  departmentId String

  // Applied only when the incoming request omits its own categoryId/
  // priorityId (or the incoming value fails department-ownership/active
  // validation) — see resolveIntegrationTicketDefaults in
  // lib/services/ticket-creation-service.ts. SetNull (not Restrict): a
  // department admin deleting a category/priority that happens to be an
  // integration's configured default must still succeed — the integration
  // just falls back to resolveDefaultStatusId-style department defaults
  // (priority) or no category at all, exactly as if it had never set one.
  defaultCategory   TicketCategory? @relation("IntegrationDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  defaultCategoryId String?
  defaultPriority   TicketPriority? @relation("IntegrationDefaultPriority", fields: [defaultPriorityId], references: [id], onDelete: SetNull)
  defaultPriorityId String?

  // Optional — when set, an incoming sourceUrl must share this exact origin
  // (scheme + host + port, real URL parsing, never string prefix matching —
  // see the endpoint). Left null, no origin check is enforced on sourceUrl.
  baseUrl String?

  // The raw API key is never stored — only enough to identify (prefix, for
  // an O(1) indexed lookup with no ambiguity, since it's @unique) and verify
  // (hash, compared with a constant-time algorithm) it. See
  // lib/services/integration-key-service.ts for generation/hashing/
  // verification — the raw value is shown to an admin exactly once, at
  // creation or rotation time, and never persisted or logged anywhere.
  apiKeyPrefix String @unique
  apiKeyHash   String
  // Optimistic-concurrency token for key rotation only (not read/checked by
  // the ticket-creation auth path at all — that's by hash comparison).
  // Incremented atomically by the rotate route's compare-and-swap update
  // (WHERE id = ... AND keyVersion = <version read at the start of the
  // request>). Two admins rotating the same integration at the same instant
  // can no longer both "win": whichever request's conditional UPDATE
  // matches zero rows loses the race and returns a controlled 409 with no
  // raw key, instead of silently generating and displaying a key that next
  // never actually becomes valid (a real gap found and fixed after an
  // external hardening audit — see integration-key-rotation-conflict in the
  // rotate route).
  keyVersion   Int    @default(1)

  lastUsedAt DateTime?

  createdBy   User?   @relation("IntegrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[] @relation("IntegrationTickets")

  @@index([departmentId])
  @@index([isActive])
}

// ─── Pending Tickets (Department Email → Pending review flow) ─────────────────
//
// Inbound email never creates a real Ticket directly anymore — it creates a
// PendingTicket, which only becomes a real Ticket (via acceptPendingTicket in
// lib/services/pending-ticket-service.ts) once a permissioned reviewer
// Accepts it. Rejecting is a soft update (status: REJECTED) — the row is
// kept for audit and never produces a Ticket. Deliberately a separate table,
// not a flag on Ticket: every existing Ticket query (buildTicketListWhere,
// GET /api/tickets, TicketTable) stays completely unaware this flow exists,
// so a pending row can never leak into "All Tickets" by omission.
enum PendingTicketStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PendingTicket {
  id     String              @id @default(cuid())
  status PendingTicketStatus @default(PENDING)

  // Real DB-unique dedup key (stronger than TicketMessage.emailMessageId's
  // app-level findFirst check, which stays for reply-append dedup) — see
  // processInboundEmails in lib/ticket-email-service.ts.
  emailMessageId String   @unique
  emailThreadId  String?
  fromEmail      String
  fromName       String?
  subject        String
  body           String   @db.Text
  receivedAt     DateTime

  // Resolved from the message's recipient(s) against Department.inboundEmail
  // at receipt time (see matchDepartmentForRecipients) — null means no
  // department address matched; visible only to Admin/Director in
  // /tickets/pending until accepted with an explicitly chosen department.
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId String?
  requester    User?       @relation("PendingTicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterId  String?

  attachments PendingTicketAttachment[]

  acceptedTicket   Ticket?   @relation(fields: [acceptedTicketId], references: [id], onDelete: SetNull)
  acceptedTicketId String?   @unique
  acceptedBy       User?     @relation("PendingTicketAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedById     String?
  acceptedAt       DateTime?
  rejectedBy       User?     @relation("PendingTicketRejected", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedById     String?
  rejectedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([requesterId])
}

model PendingTicketAttachment {
  id              String        @id @default(cuid())
  pendingTicket   PendingTicket @relation(fields: [pendingTicketId], references: [id], onDelete: Cascade)
  pendingTicketId String

  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String

  createdAt DateTime @default(now())

  @@index([pendingTicketId])
}

model TicketMessage {
  id       String  @id @default(cuid())
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?
  body     String  @db.Text

  direction  MessageDirection @default(OUTBOUND)
  isInternal Boolean          @default(false)

  emailMessageId String?
  fromEmail      String?
  fromName       String?

  attachments TicketAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([emailMessageId])
}

model TicketAttachment {
  id           String         @id @default(cuid())
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  message      TicketMessage? @relation(fields: [messageId], references: [id])
  messageId    String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime       @default(now())

  @@index([ticketId])
}

model TicketHistory {
  id          String            @id @default(cuid())
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  changedBy   User?             @relation(fields: [changedById], references: [id])
  changedById String?
  type        TicketHistoryType
  oldValue    String?
  newValue    String?
  description String?
  createdAt   DateTime          @default(now())

  @@index([ticketId])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id              String         @id @default(cuid())
  title           String
  description     String?        @db.Text
  status          ProjectStatus  @default(PLANNING)
  priority        Int            @default(2)
  progress        Int            @default(0)
  owner           User           @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId         String
  department      Department?    @relation(fields: [departmentId], references: [id])
  departmentId    String?
  // Must belong to the same departmentId as this project — validated in
  // lib/services/sub-department-service.ts, not enforced at the DB level.
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId String?
  businessUnit    BusinessUnit?  @relation(fields: [businessUnitId], references: [id])
  businessUnitId  String?
  startDate       DateTime?
  endDate         DateTime?
  successTarget   String?        @db.Text
  isGoal          Boolean        @default(false)

  members     User[]            @relation("ProjectMembers")
  activities  ProjectActivity[]
  tickets     Ticket[]
  yearlyGoals YearlyGoal[]      @relation("GoalProjects")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([departmentId])
  @@index([subDepartmentId])
}

model ProjectActivity {
  id              String               @id @default(cuid())
  title           String
  description     String?              @db.Text
  status          ActivityStatus       @default(TODO)
  priority        ActivityPriority     @default(MEDIUM)
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId       String?
  assignedUser    User?                @relation("ActivityAssignee", fields: [assignedUserId], references: [id])
  assignedUserId  String?
  assignedUsers   User[]               @relation("ActivityAssignees")
  createdBy       User?                @relation("ActivityCreator", fields: [createdById], references: [id])
  createdById     String?
  department      Department?          @relation(fields: [departmentId], references: [id])
  departmentId    String?
  // Must belong to the same departmentId as this activity — validated in
  // lib/services/sub-department-service.ts, not enforced at the DB level.
  subDepartment   SubDepartment?       @relation(fields: [subDepartmentId], references: [id])
  subDepartmentId String?
  businessUnit    BusinessUnit?        @relation(fields: [businessUnitId], references: [id])
  businessUnitId  String?
  startDate       DateTime?
  dueDate         DateTime?
  progress        Int                  @default(0)
  isMilestone     Boolean              @default(false)
  completedAt     DateTime?
  isCompleted     Boolean              @default(false)
  tickets         Ticket[]
  predecessorDeps ActivityDependency[] @relation("ActivityDependencyPredecessor")
  successorDeps   ActivityDependency[] @relation("ActivityDependencySuccessor")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([projectId])
  @@index([assignedUserId])
  @@index([createdById])
  @@index([status])
  @@index([departmentId])
  @@index([subDepartmentId])
}

// Per-department, editable status->progress% mapping — Activity progress is
// derived from status (see lib/activities/activity-progress.ts), never
// manually entered, but each department may set its own percentages (e.g.
// IT might treat BLOCKED as 50%, another department as 25%). Full CRUD via
// /admin/activity-progress: a department may disable (isEnabled) or delete
// a status's row entirely — the resolver treats either as a configuration
// gap (logged, fail-safe), never a hardcoded per-status-name guess. Every
// department is backfilled with all 6 rows (see the migration and
// lib/services/config-starter-data.ts's ensureActivityProgressConfigForDepartment)
// so this is only ever reached in practice via a deliberate admin delete.
model ActivityProgressConfig {
  id              String         @id @default(cuid())
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId    String
  status          ActivityStatus
  progressPercent Int            @default(0)
  isEnabled       Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([departmentId, status])
  @@index([departmentId, isEnabled])
}

// Which ProjectStatus/ActivityStatus values count as "terminal" (done/
// closed, in the same sense TicketStatus.isClosed already captures for
// tickets) — per department, since a status name alone (e.g. "Cancelled")
// carries no terminal-ness signal on its own and no code should hardcode
// that assumption. Same shape/precedent as ActivityProgressConfig directly
// above: a department-scoped, status-keyed config row, admin-editable,
// with hardcoded defaults (COMPLETED/CANCELLED = terminal, everything else
// = not) as the fallback whenever no row exists yet — see
// lib/status-terminal.ts, the single place that reads these with that
// fallback baked in, and lib/overdue.ts, which is the only consumer that
// needs "is this terminal" at all. Not all 5/6 status values need a row
// per department up front (unlike ActivityProgressConfig's "always seed
// all 6"): an absent row just means "use the default", which is exactly
// today's implicit (hardcoded) behavior — so this migration changes
// nothing observable for any existing department until an admin opts in.
model ProjectStatusConfig {
  id           String        @id @default(cuid())
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  status       ProjectStatus
  isTerminal   Boolean
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([departmentId, status])
}

// Department-scoped display metadata AND terminal-ness for ActivityStatus —
// the SAME row/table the pre-existing isTerminal resolution
// (lib/status-terminal.ts) already reads, extended rather than duplicated
// (lib/services/activity-status-config.ts reads the new columns). The fixed
// ActivityStatus enum key (TODO, IN_PROGRESS, ...) never changes — only its
// department-specific label/color/sortOrder/isEnabled/isTerminal do, e.g.
// IT's TODO can display "To Do" while Sales' TODO displays "New Activity",
// independently, without ever touching the Prisma enum itself.
model ActivityStatusConfig {
  id           String         @id @default(cuid())
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  status       ActivityStatus
  // Backfilled from the previous app-wide hardcoded label
  // (components/gantt/status-colors.ts's STATUS_LABEL) for all pre-existing
  // rows — admin-editable per department afterward.
  label        String
  color        String         @default("#94a3b8")
  sortOrder    Int            @default(0)
  isEnabled    Boolean        @default(true)
  isTerminal   Boolean
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([departmentId, status])
  @@index([departmentId, isEnabled])
}

// Department-scoped enablement + display order for ActivityPriority values
// — the same "scoped configuration, admin-editable, full-backfilled row set"
// precedent as ActivityProgressConfig/ProjectStatusConfig/ActivityStatusConfig
// above, this time for priority. `sortOrder` is what "the configured order"
// (Project Gantt's Priority filter, Resource Planning's own priority list)
// actually reads — never a hardcoded URGENT>HIGH>MEDIUM>LOW constant.
// `isEnabled` controls whether a value is offered as a NEW selectable filter
// option; a record already carrying a disabled priority stays fully visible
// everywhere it's shown (see lib/priority-config.ts) — disabling only
// affects what's offered going forward, exactly like TicketPriority.isActive.
model ActivityPriorityConfig {
  id           String           @id @default(cuid())
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  priority     ActivityPriority
  sortOrder    Int
  isEnabled    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([departmentId, priority])
}

model ActivityDependency {
  id            String          @id @default(cuid())
  predecessorId String
  predecessor   ProjectActivity @relation("ActivityDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     ProjectActivity @relation("ActivityDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type          DependencyType  @default(FINISH_TO_START)
  createdById   String?
  createdBy     User?           @relation("ActivityDependenciesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([predecessorId, successorId, type])
  @@index([predecessorId])
  @@index([successorId])
}

// ─── Yearly Goals ─────────────────────────────────────────────────────────────

model YearlyGoal {
  id           String     @id @default(cuid())
  year         Int
  status       GoalStatus @default(NOT_STARTED)
  targetValue  Float?
  currentValue Float?
  unit         String?
  owner        User       @relation("GoalOwner", fields: [ownerUserId], references: [id])
  ownerUserId  String
  projects     Project[]  @relation("GoalProjects")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([year])
  @@index([ownerUserId])
}

// ─── Custom Roles ─────────────────────────────────────────────────────────────

// Which role system a CustomRole row represents. RolePermission.roleKey is a
// bare string shared by both the global Role enum and the DepartmentRole
// enum (see the RolePermission model below) — this field is what lets
// /admin/roles show two separate tabs from the same table, and lets the
// permission-grant route block department-scoped roles from ever getting
// system-administration permissions (admin.access/user.manage/role.manage).
// BOTH exists for DEPARTMENT_MANAGER specifically: it's one intentionally
// shared roleKey used by both Role.DEPARTMENT_MANAGER and
// DepartmentRole.DEPARTMENT_MANAGER (see prisma/seed.ts) — not two rows.
enum RoleScope {
  GLOBAL
  DEPARTMENT
  BOTH
}

model CustomRole {
  id                    String                 @id @default(cuid())
  key                   String                 @unique
  name                  String
  description           String?
  isBuiltIn             Boolean                @default(false)
  // Disable lever for built-in roles (which can never be hard-deleted — see
  // lib/services/role-safety-service.ts) and custom roles alike. A disabled
  // role stops being offered for new assignment (getDepartmentRoleOptions)
  // and hasPermission/hasDepartmentPermission fall back to the caller's base
  // enum role when their customRoleId points at an inactive row — but an
  // enum-based built-in role (User.role/DepartmentMembership.role used
  // directly, no customRoleId) can't be retroactively revoked this way; see
  // the doc-comment on wouldOrphanAdminAccessByDisablingRole.
  isActive              Boolean                @default(true)
  scope                 RoleScope              @default(GLOBAL)
  users                 User[]                 @relation("UserCustomRole")
  departmentMemberships DepartmentMembership[] @relation("DepartmentMembershipCustomRole")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// ─── Permissions ──────────────────────────────────────────────────────────────

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  module      String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleKey      String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@id([roleKey, permissionId])
  @@index([roleKey])
}

// ─── SLA ──────────────────────────────────────────────────────────────────────

model SlaSettings {
  id        String   @id @default(cuid())
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model SlaPolicy {
  id                 String         @id @default(cuid())
  priority           TicketPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  priorityId         String         @unique
  firstResponseHours Int            @default(8)
  resolutionHours    Int            @default(48)
  updatedAt          DateTime       @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Email Processing ─────────────────────────────────────────────────────────

enum EmailLogAction {
  CREATED_TICKET
  APPENDED_REPLY
  SKIPPED_DUPLICATE
  SKIPPED_LOOP
  FAILED
}

model EmailProcessingLog {
  id        String         @id @default(cuid())
  runId     String
  messageId String?
  fromEmail String?
  subject   String?
  action    EmailLogAction
  ticketId  String?
  error     String?        @db.Text
  createdAt DateTime       @default(now())

  @@index([runId])
  @@index([createdAt])
  @@index([action])
}

model EmailPollRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  created    Int       @default(0)
  appended   Int       @default(0)
  skipped    Int       @default(0)
  errors     Int       @default(0)
  lastError  String?   @db.Text
  succeeded  Boolean   @default(false)

  @@index([startedAt])
}

// ─── Outbound Notification Log ────────────────────────────────────────────────

enum EmailNotificationType {
  REPLY
  CLOSED
  CREATED
}

enum EmailNotificationStatus {
  SENT
  FAILED
  SKIPPED
  // Claimed but not yet resolved — see eventKey below. A row is inserted
  // with this status FIRST (the insert itself is the atomic ownership
  // claim, via the unique constraint on eventKey), then updated to
  // SENT/FAILED/SKIPPED once the actual send attempt resolves.
  PENDING
}

model EmailNotificationLog {
  id             String                  @id @default(cuid())
  ticketId       String
  messageId      String?
  recipientEmail String
  type           EmailNotificationType
  status         EmailNotificationStatus
  error          String?                 @db.Text
  createdAt      DateTime                @default(now())
  // Database-backed idempotency for lifecycle events (CREATED/CLOSED) that
  // must fire at most once per real transition, safe under concurrent or
  // retried requests — a plain findFirst-before-create has a TOCTOU race
  // under concurrency, so this unique constraint is the actual guard: the
  // INSERT with a given eventKey either succeeds (this call now atomically
  // owns the event) or fails with P2002 (some other call already claimed
  // it), never both succeeding. Null for REPLY rows (unchanged, no
  // eventKey-based dedupe requested for that type — its own
  // messageId/direction check already prevents loops) — Postgres allows
  // unlimited NULLs under a unique index, so this is fully backward
  // compatible with existing REPLY log rows. Format: `ticket:{id}:created`
  // for the one-time creation event; `ticket:{id}:closed:{closedAt ISO}`
  // for a close transition, so a genuine reopen-then-reclose produces a new
  // key (new closedAt) and is allowed to send a new email, while a retry of
  // the SAME transition (same closedAt) collapses onto the same row.
  eventKey       String?                 @unique

  @@index([ticketId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}
