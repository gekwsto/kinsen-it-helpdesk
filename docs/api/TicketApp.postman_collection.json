{
  "info": {
    "name": "TicketApp API",
    "description": "Βασισμένο αποκλειστικά στον πραγματικό κώδικα του TicketApp repository. Σχεδόν κάθε request εδώ απαιτεί ένα έγκυρο Auth.js `authjs.session-token` session cookie — δες docs/api/AUTHENTICATION.md. Το collection ΔΕΝ περιέχει κανένα πραγματικό cookie/secret. Δες τις οδηγίες στο τέλος αυτής της περιγραφής για το πώς να προσθέσεις το δικό σου session cookie τοπικά.\n\nΟδηγίες για local testing:\n1. Κάνε login στο TicketApp μέσω browser (http://localhost:3000/login).\n2. Άνοιξε τα DevTools → Application/Storage → Cookies → βρες το `authjs.session-token`.\n3. Αντίγραψε την τιμή του και βάλε την στο Postman environment variable `sessionCookie` (όχι εδώ στο collection).\n4. Το `sessionCookie` χρησιμοποιείται αυτόματα ως `Cookie: authjs.session-token={{sessionCookie}}` header σε κάθε request.\n\nΟι φάκελοι \"Gantt\" και \"Resource Planning\" περιλαμβάνονται σκόπιμα κενοί — αυτά τα features είναι αποκλειστικά server-rendered (Next.js Server Components), χωρίς κανένα πραγματικό JSON API endpoint σήμερα. Βλ. docs/api/EXTERNAL_API_READINESS.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "sessionCookie", "value": "", "type": "string" },
    { "key": "departmentId", "value": "", "type": "string" },
    { "key": "ticketId", "value": "", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "activityId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "statusId", "value": "", "type": "string" },
    { "key": "priorityId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Auth.js session/OAuth catch-all. Δεν υπάρχει κανένα endpoint εδώ για να δημιουργήσεις session προγραμματιστικά — μόνο interactive browser login. Αυτό το request επιβεβαιώνει ότι ένα ήδη υπάρχον sessionCookie είναι έγκυρο.",
      "item": [
        {
          "name": "Get current session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/session", "host": ["{{baseUrl}}"], "path": ["api", "auth", "session"] },
            "description": "Auth.js built-in route (μέρος του catch-all /api/auth/{nextauth}). Επιστρέφει το τρέχον session object, ή {} αν άκυρο/ληγμένο."
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "List tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?page=1&limit=20&departmentId={{departmentId}}",
              "host": ["{{baseUrl}}"], "path": ["api", "tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "departmentId", "value": "{{departmentId}}" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "statusId", "value": "{{statusId}}", "disabled": true },
                { "key": "priorityId", "value": "{{priorityId}}", "disabled": true },
                { "key": "myOnly", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Δεν μπορώ να συνδεθώ στο VPN\",\n  \"description\": \"Το VPN client δίνει σφάλμα timeout από το πρωί.\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"priorityId\": \"{{priorityId}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"shareWithDepartment\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets"] }
          }
        },
        {
          "name": "Get ticket",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}"] }
          }
        },
        {
          "name": "Update ticket",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"priorityId\": \"{{priorityId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}"] }
          }
        },
        {
          "name": "Change status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"statusId\": \"{{statusId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "status"] }
          }
        },
        {
          "name": "Assign agent",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"assignedAgentId\": \"{{userId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "assign"] }
          }
        },
        {
          "name": "Move department",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"departmentId\": \"{{departmentId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/department", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "department"] }
          }
        },
        {
          "name": "Add reply/comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Ελέγχω το θέμα.\",\n  \"isInternal\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/reply", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "reply"] }
          }
        },
        {
          "name": "Cancel ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"cancelReasonId\": \"<cancelReasonId>\",\n  \"note\": \"Λύθηκε από τον χρήστη.\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "cancel"] }
          }
        },
        {
          "name": "Delete ticket (Administrator only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}"] }
          }
        },
        {
          "name": "Accept pending ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"departmentId\": \"{{departmentId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/pending/<pendingTicketId>/accept", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "pending", "<pendingTicketId>", "accept"] }
          }
        },
        {
          "name": "Reject pending ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "authjs.session-token={{sessionCookie}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/pending/<pendingTicketId>/reject", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "pending", "<pendingTicketId>", "reject"] }
          }
        }
      ]
    },
